<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.trasmum.loja.apresentacao.controllers.UtilizadorController"
      spacing="12" styleClass="view-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Gestão de Utilizadores" styleClass="view-title"/>

    <HBox spacing="8">
        <Button text="Criar"     onAction="#onCriar"     styleClass="btn-primary"/>
        <Button text="Editar"    onAction="#onEditar"    styleClass="btn-secondary"/>
        <Button text="Desativar" onAction="#onDesativar" styleClass="btn-danger"/>
    </HBox>

    <TableView fx:id="tblUtilizadores" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome"   text="Nome de utilizador" prefWidth="200"/>
            <TableColumn fx:id="colPerfil" text="Perfil"             prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
