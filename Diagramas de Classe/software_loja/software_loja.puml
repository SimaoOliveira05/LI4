@startuml Software_de_Loja_v2
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #EEEDFE
skinparam classBorderColor #534AB7
skinparam classBackgroundColor #FAFAFA
skinparam arrowColor #534AB7
skinparam stereotypeCBackgroundColor #E1F5EE
skinparam stereotypeABackgroundColor #FAC775
skinparam stereotypeIBackgroundColor #D1ECF1
skinparam packageBackgroundColor #F8F8F8
skinparam packageBorderColor #B4B2A9
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50

title Software de Loja — Diagrama de Classes (Layered Architecture + MVC)

' ╔══════════════════════════════════════╗
' ║        CAMADA DE APRESENTAÇÃO        ║
' ╚══════════════════════════════════════╝
package "Apresentação (Controllers JavaFX)" #EEF4FF {

  class AutenticacaoController {
    - autenticacaoServico : AutenticacaoServico
    + onLoginSubmit(evento : ActionEvent) : void
    + onLogout(evento : ActionEvent) : void
  }

  class VendaController {
    - vendaServico : VendaServico
    - caixaServico : CaixaServico
    + onLerCodigoBarras(codigo : String) : void
    + onFinalizarVenda(metodo : MetodoPagamento, valorEntregue : double) : void
    + onAnularVenda() : void
    + onAdicionarLinha(codigo : String, quantidade : int) : void
  }

  class DevolucaoController {
    - devolucaoServico : DevolucaoServico
    + onProcessarDevolucao(numeroFatura : String, codigoBarras : String, dataValidade : LocalDate, quantidade : int) : void
  }

  class RemessaController {
    - remessaServico : RemessaServico
    + onRegistarRemessa(dados : RemessaDTO) : void
    + onCriarPedidoRemessa(dados : PedidoRemessaDTO) : void
    + onConsultarPedidos(estado : EstadoPedido) : void
  }

  class PagamentoController {
    - pagamentoServico : PagamentoServico
    + onListarPendentes() : void
    + onLiquidar(idPagamento : int) : void
  }

  class CatalogoController {
    - catalogoServico : CatalogoServico
    + onCriarProduto(dados : ProdutoDTO) : void
    + onEditarProduto(id : int, dados : ProdutoDTO) : void
    + onDesativarProduto(id : int) : void
    + onAplicarDesconto(idLote : int, percentagem : double) : void
    + onConsultarAlertas() : void
  }

  class CaixaController {
    - caixaServico : CaixaServico
    + onAbrirSessao(fundo : List~DetalheNumerario~) : void
    + onRegistarSangria(valor : List~DetalheNumerario~) : void
    + onFecharSessao() : void
  }

  class FechoDiaController {
    - fechoDiaServico : FechoDiaServico
    + onIniciarFecho() : void
    + onReenviar() : void
  }

  class UtilizadorController {
    - utilizadorServico : UtilizadorServico
    + onCriarUtilizador(dados : UtilizadorDTO) : void
    + onDesativarUtilizador(id : int) : void
    + onEditarUtilizador(id : int, dados : UtilizadorDTO) : void
  }
}

' ╔══════════════════════════════════════╗
' ║          CAMADA DE SERVIÇO           ║
' ╚══════════════════════════════════════╝
package "Serviço (Lógica de Negócio)" #EEF9F4 {

  class AutenticacaoServico {
    - utilizadorRepositorio : UtilizadorRepositorio
    + autenticar(nomeUtilizador : String, palavraPasse : String) : Utilizador
    + encerrarSessao(utilizador : Utilizador) : void
    + verificarSessaoDuplicada(utilizador : Utilizador) : boolean
  }

  class VendaServico {
    - vendaRepositorio : VendaRepositorio
    - loteRepositorio : LoteRepositorio
    - caixaRepositorio : SessaoCaixaRepositorio
    - auditoriaServico : AuditoriaServico
    + iniciarVenda(utilizador : Utilizador) : Venda
    + adicionarLinha(venda : Venda, codigoBarras : String, quantidade : int) : LinhaVenda
    + finalizarVenda(venda : Venda, metodo : MetodoPagamento, valorEntregue : double) : Fatura
    + anularVenda(venda : Venda) : void
    + calcularTroco(total : double, valorEntregue : double) : double
  }

  class DevolucaoServico {
    - devolucaoRepositorio : DevolucaoRepositorio
    - faturaRepositorio : FaturaRepositorio
    - loteRepositorio : LoteRepositorio
    - auditoriaServico : AuditoriaServico
    + processar(numeroFatura : String, codigoBarras : String, dataValidadeEmbalagem : LocalDate, quantidade : int) : Devolucao
    + validar(fatura : Fatura, lote : Lote, quantidade : int) : boolean
  }

  class RemessaServico {
    - remessaRepositorio : RemessaRepositorio
    - pedidoRemessaRepositorio : PedidoRemessaRepositorio
    - loteRepositorio : LoteRepositorio
    - pagamentoRepositorio : PagamentoRepositorio
    - auditoriaServico : AuditoriaServico
    + registarRemessa(utilizador : Utilizador, fornecedor : Fornecedor, linhas : List~LinhaRemessa~, valorTotalGuia : double) : Remessa
    + associarPedidoPendente(remessa : Remessa) : void
    + criarPedidoRemessa(utilizador : Utilizador, fornecedor : Fornecedor, linhas : List~LinhaPedidoRemessa~) : PedidoRemessa
    + listarPedidos(estado : EstadoPedido) : List~PedidoRemessa~
  }

  class PagamentoServico {
    - pagamentoRepositorio : PagamentoRepositorio
    - auditoriaServico : AuditoriaServico
    + listarPendentes() : List~Pagamento~
    + liquidar(idPagamento : int, utilizador : Utilizador) : void
  }

  class CatalogoServico {
    - produtoRepositorio : ProdutoRepositorio
    - loteRepositorio : LoteRepositorio
    - auditoriaServico : AuditoriaServico
    + criarProduto(utilizador : Utilizador, dados : ProdutoDTO) : Produto
    + editarProduto(utilizador : Utilizador, id : int, dados : ProdutoDTO) : void
    + desativarProduto(utilizador : Utilizador, id : int) : void
    + aplicarDesconto(utilizador : Utilizador, idLote : int, percentagem : double) : Desconto
    + gerarAlertasStockMinimo() : List~Produto~
    + gerarAlertasValidade(diasLimite : int) : List~Lote~
    + pesquisarProduto(query : String) : List~Produto~
  }

  class CaixaServico {
    - sessaoCaixaRepositorio : SessaoCaixaRepositorio
    - sangriaRepositorio : SangriaRepositorio
    + abrirSessao(utilizador : Utilizador, fundo : List~DetalheNumerario~, limiteMaximo : double) : SessaoCaixa
    + registarSangria(sessao : SessaoCaixa, utilizador : Utilizador, valor : List~DetalheNumerario~) : Sangria
    + fecharSessao(sessao : SessaoCaixa) : void
    + verificarLimite(sessao : SessaoCaixa) : boolean
  }

  class FechoDiaServico {
    - vendaRepositorio : VendaRepositorio
    - devolucaoRepositorio : DevolucaoRepositorio
    - remessaRepositorio : RemessaRepositorio
    - pagamentoRepositorio : PagamentoRepositorio
    - auditoriaRepositorio : LogAuditoriaRepositorio
    - fechoDiaRepositorio : FechoDiaRepositorio
    + executarFecho(utilizador : Utilizador, configuracao : ConfiguracaoTerminal) : FechoDia
    + reenviar(idFecho : int) : boolean
    + reverterEmTransito() : void
  }

  class UtilizadorServico {
    - utilizadorRepositorio : UtilizadorRepositorio
    - auditoriaServico : AuditoriaServico
    + criar(gestor : Utilizador, dados : UtilizadorDTO) : Utilizador
    + desativar(gestor : Utilizador, idAlvo : int) : void
    + editar(gestor : Utilizador, idAlvo : int, dados : UtilizadorDTO) : void
    + validarGestorAtivo(idLoja : String) : void
  }

  class AuditoriaServico {
    - logAuditoriaRepositorio : LogAuditoriaRepositorio
    + registar(utilizador : Utilizador, acao : TipoAcao, entidade : String, idEntidade : int) : void
  }
}

' ╔══════════════════════════════════════╗
' ║         CAMADA DE REPOSITÓRIO        ║
' ╚══════════════════════════════════════╝
package "Repositório (Acesso a Dados)" #FFF8EE {

  interface UtilizadorRepositorio {
    + buscarPorCredenciais(nomeUtilizador : String, hashPalavraPasse : String) : Utilizador
    + buscarPorId(id : int) : Utilizador
    + guardar(utilizador : Utilizador) : void
    + atualizar(utilizador : Utilizador) : void
    + desativar(id : int) : void
    + verificarSessaoAtiva(id : int) : boolean
  }

  class UtilizadorRepositorioImpl {
    - conexao : Connection
    + buscarPorCredenciais(nomeUtilizador : String, hashPalavraPasse : String) : Utilizador
    + buscarPorId(id : int) : Utilizador
    + guardar(utilizador : Utilizador) : void
    + atualizar(utilizador : Utilizador) : void
    + desativar(id : int) : void
    + verificarSessaoAtiva(id : int) : boolean
  }

  interface ProdutoRepositorio {
    + buscarPorCodigoBarras(codigo : String) : Produto
    + buscarPorNomeOuCategoria(query : String) : List~Produto~
    + guardar(produto : Produto) : void
    + atualizar(produto : Produto) : void
    + desativar(id : int) : void
    + buscarAbaixoStockMinimo() : List~Produto~
  }

  class ProdutoRepositorioImpl {
    - conexao : Connection
    + buscarPorCodigoBarras(codigo : String) : Produto
    + buscarPorNomeOuCategoria(query : String) : List~Produto~
    + guardar(produto : Produto) : void
    + atualizar(produto : Produto) : void
    + desativar(id : int) : void
    + buscarAbaixoStockMinimo() : List~Produto~
  }

  interface LoteRepositorio {
    + buscarLotesFEFO(idProduto : int) : List~Lote~
    + buscarPorValidade(diasLimite : int) : List~Lote~
    + guardar(lote : Lote) : void
    + atualizar(lote : Lote) : void
  }

  class LoteRepositorioImpl {
    - conexao : Connection
    + buscarLotesFEFO(idProduto : int) : List~Lote~
    + buscarPorValidade(diasLimite : int) : List~Lote~
    + guardar(lote : Lote) : void
    + atualizar(lote : Lote) : void
  }

  interface VendaRepositorio {
    + guardar(venda : Venda) : void
    + buscarPorId(id : int) : Venda
    + buscarPendentes() : List~Venda~
    + marcarConfirmadas(ids : List~Integer~) : void
  }

  class VendaRepositorioImpl {
    - conexao : Connection
    + guardar(venda : Venda) : void
    + buscarPorId(id : int) : Venda
    + buscarPendentes() : List~Venda~
    + marcarConfirmadas(ids : List~Integer~) : void
  }

  interface FaturaRepositorio {
    + buscarPorNumero(numeroFatura : String) : Fatura
    + guardar(fatura : Fatura) : void
  }

  class FaturaRepositorioImpl {
    - conexao : Connection
    + buscarPorNumero(numeroFatura : String) : Fatura
    + guardar(fatura : Fatura) : void
  }

  interface DevolucaoRepositorio {
    + guardar(devolucao : Devolucao) : void
    + buscarPorFatura(numeroFatura : String) : List~Devolucao~
    + buscarPendentes() : List~Devolucao~
  }

  class DevolucaoRepositorioImpl {
    - conexao : Connection
    + guardar(devolucao : Devolucao) : void
    + buscarPorFatura(numeroFatura : String) : List~Devolucao~
    + buscarPendentes() : List~Devolucao~
  }

  interface RemessaRepositorio {
    + guardar(remessa : Remessa) : void
    + buscarPorFornecedor(idFornecedor : int) : List~Remessa~
    + buscarPendentes() : List~Remessa~
  }

  class RemessaRepositorioImpl {
    - conexao : Connection
    + guardar(remessa : Remessa) : void
    + buscarPorFornecedor(idFornecedor : int) : List~Remessa~
    + buscarPendentes() : List~Remessa~
  }

  interface PedidoRemessaRepositorio {
    + guardar(pedido : PedidoRemessa) : void
    + buscarPendentesPorFornecedor(idFornecedor : int) : List~PedidoRemessa~
    + atualizar(pedido : PedidoRemessa) : void
    + listar(estado : EstadoPedido) : List~PedidoRemessa~
  }

  class PedidoRemessaRepositorioImpl {
    - conexao : Connection
    + guardar(pedido : PedidoRemessa) : void
    + buscarPendentesPorFornecedor(idFornecedor : int) : List~PedidoRemessa~
    + atualizar(pedido : PedidoRemessa) : void
    + listar(estado : EstadoPedido) : List~PedidoRemessa~
  }

  interface PagamentoRepositorio {
    + guardar(pagamento : Pagamento) : void
    + buscarPendentes() : List~Pagamento~
    + atualizar(pagamento : Pagamento) : void
  }

  class PagamentoRepositorioImpl {
    - conexao : Connection
    + guardar(pagamento : Pagamento) : void
    + buscarPendentes() : List~Pagamento~
    + atualizar(pagamento : Pagamento) : void
  }

  interface SessaoCaixaRepositorio {
    + guardar(sessao : SessaoCaixa) : void
    + atualizar(sessao : SessaoCaixa) : void
    + buscarSessaoAtiva(idUtilizador : int) : SessaoCaixa
  }

  class SessaoCaixaRepositorioImpl {
    - conexao : Connection
    + guardar(sessao : SessaoCaixa) : void
    + atualizar(sessao : SessaoCaixa) : void
    + buscarSessaoAtiva(idUtilizador : int) : SessaoCaixa
  }

  interface SangriaRepositorio {
    + guardar(sangria : Sangria) : void
    + buscarPorSessao(idSessao : int) : List~Sangria~
  }

  class SangriaRepositorioImpl {
    - conexao : Connection
    + guardar(sangria : Sangria) : void
    + buscarPorSessao(idSessao : int) : List~Sangria~
  }

  interface LogAuditoriaRepositorio {
    + guardar(log : LogAuditoria) : void
    + buscarPendentes() : List~LogAuditoria~
  }

  class LogAuditoriaRepositorioImpl {
    - conexao : Connection
    + guardar(log : LogAuditoria) : void
    + buscarPendentes() : List~LogAuditoria~
  }

  interface FechoDiaRepositorio {
    + guardar(fecho : FechoDia) : void
    + atualizar(fecho : FechoDia) : void
    + buscarUltimoConfirmado() : FechoDia
  }

  class FechoDiaRepositorioImpl {
    - conexao : Connection
    + guardar(fecho : FechoDia) : void
    + atualizar(fecho : FechoDia) : void
    + buscarUltimoConfirmado() : FechoDia
  }
}

' ╔══════════════════════════════════════╗
' ║           CAMADA DE DOMÍNIO          ║
' ╚══════════════════════════════════════╝
package "Domínio (Entidades e Enumerações)" #FEFEFE {

  class ConfiguracaoTerminal {
    - idLoja : String
    - nomeLoja : String
    + getIdLoja() : String
    + getNomeLoja() : String
  }
  note bottom of ConfiguracaoTerminal
    Lida do ficheiro de configuração
    no arranque (ADR-02, RF2).
    Não persistida. Não alterável
    pela interface da aplicação.
  end note

  abstract class RegistoSincronizavel {
    # id : int
    # estadoSincronizacao : EstadoSincronizacao
    # idLoja : String
    + getEstadoSincronizacao() : EstadoSincronizacao
    + marcarEmTransito() : void
    + marcarConfirmado() : void
    + reverterParaPendente() : void
  }
  note bottom of RegistoSincronizavel
    idLoja copiado de ConfiguracaoTerminal
    na criação (ADR-05).
    CONFIRMADO apenas após ACK (ADR-04).
    EM_TRANSITO → PENDENTE em reinício.
  end note

  enum EstadoSincronizacao {
    PENDENTE
    EM_TRANSITO
    CONFIRMADO
  }

  class Utilizador {
    - id : int
    - nomeUtilizador : String
    - hashPalavraPasse : String
    - perfil : PerfilUtilizador
    - ativo : boolean
    - emSessao : boolean
    + getId() : int
    + getPerfil() : PerfilUtilizador
    + isAtivo() : boolean
    + isEmSessao() : boolean
  }
  note bottom of Utilizador
    Perfil por composição, não herança.
    Autorização decidida pelo serviço
    com base em perfil (RF2).
  end note

  enum PerfilUtilizador {
    FUNCIONARIO
    GESTOR
    CEO
  }

  class Produto {
    - id : int
    - codigoBarras : String
    - nome : String
    - categoria : String
    - precoBase : double
    - stockMinimo : int
    - ativo : boolean
    + getId() : int
    + getCodigoBarras() : String
    + getStockMinimo() : int
    + isAtivo() : boolean
  }

  class Lote {
    - id : int
    - idProduto : int
    - quantidade : int
    - dataValidade : LocalDate
    - precoVenda : double
    + getId() : int
    + getIdProduto() : int
    + getQuantidade() : int
    + getDataValidade() : LocalDate
    + getPrecoFinal() : double
    + temDesconto() : boolean
  }

  class Desconto {
    - percentagem : double
    - dataAplicacao : LocalDate
    - idUtilizadorAplicou : int
    + getPercentagem() : double
    + getDataAplicacao() : LocalDate
  }
  note bottom of Desconto
    idUtilizadorAplicou referencia
    um Utilizador com perfil
    GESTOR ou CEO (RF22).
  end note

  class Venda {
    - dataHora : LocalDateTime
    - metodoPagamento : MetodoPagamento
    - totalFaturado : double
    - estado : EstadoVenda
    - idUtilizador : int
    + getDataHora() : LocalDateTime
    + getMetodoPagamento() : MetodoPagamento
    + getTotalFaturado() : double
    + getEstado() : EstadoVenda
    + getIdUtilizador() : int
  }

  class LinhaVenda {
    - id : int
    - idVenda : int
    - idLote : int
    - quantidade : int
    - precoUnitario : double
    + calcularSubtotal() : double
    + getIdLote() : int
  }

  class Fatura {
    - numeroFatura : String
    - dataEmissao : LocalDateTime
    - nifCliente : String
    - idVenda : int
    + getNumeroFatura() : String
    + getNifCliente() : String
    + getIdVenda() : int
  }
  note bottom of Fatura
    numeroFatura: identificador único (RF5).
    nifCliente: campo facultativo.
  end note

  enum MetodoPagamento {
    NUMERARIO
    MULTIBANCO
  }

  enum EstadoVenda {
    EM_CURSO
    FINALIZADA
    ANULADA
  }

  class Devolucao {
    - dataHora : LocalDateTime
    - quantidade : int
    - dataValidadeEmbalagem : LocalDate
    - numeroFatura : String
    - idUtilizador : int
    + getNumeroFatura() : String
    + getQuantidade() : int
    + getDataValidadeEmbalagem() : LocalDate
  }

  class Fornecedor {
    - id : int
    - nome : String
    - nif : String
    - morada : String
    - telefone : String
    - email : String
    - iban : String
    + getId() : int
    + getNome() : String
    + getIban() : String
  }

  class Remessa {
    - dataRecepcao : LocalDate
    - valorTotalGuia : double
    - idFornecedor : int
    - idUtilizador : int
    + getIdFornecedor() : int
    + getDataRecepcao() : LocalDate
    + getValorTotalGuia() : double
  }

  class LinhaRemessa {
    - id : int
    - idRemessa : int
    - idProduto : int
    - idLoteGerado : int
    - quantidade : int
    - dataValidade : LocalDate
    + getIdProduto() : int
    + getIdLoteGerado() : int
    + getQuantidade() : int
  }

  class PedidoRemessa {
    - id : int
    - idFornecedor : int
    - idUtilizador : int
    - dataCriacao : LocalDate
    - estado : EstadoPedido
    + getIdFornecedor() : int
    + getEstado() : EstadoPedido
    + estaPendente() : boolean
  }

  class LinhaPedidoRemessa {
    - id : int
    - idPedido : int
    - idProduto : int
    - quantidadePretendida : int
    + getIdProduto() : int
    + getQuantidadePretendida() : int
  }

  enum EstadoPedido {
    PENDENTE
    CONCLUIDO
  }

  class Pagamento {
    - valor : double
    - dataPagamento : LocalDate
    - tipoPagamento : TipoPagamento
    - idFornecedor : int
    - idRemessa : int
    - idUtilizador : int
    + getIdFornecedor() : int
    + getIdRemessa() : int
    + getTipoPagamento() : TipoPagamento
  }

  enum TipoPagamento {
    TRANSFERENCIA
    NUMERARIO
    CHEQUE
  }

  class SessaoCaixa {
    - id : int
    - idUtilizador : int
    - fundoInicial : List~DetalheNumerario~
    - saldoAtual : double
    - limiteMaximo : double
    - dataAbertura : LocalDateTime
    - dataEncerramento : LocalDateTime
    + getSaldoAtual() : double
    + excedeLimite() : boolean
    + getIdUtilizador() : int
  }
  note bottom of SessaoCaixa
    idUtilizador garante rastreabilidade
    ao utilizador autenticado (RF1, RF9).
  end note

  class Sangria {
    - id : int
    - idSessaoCaixa : int
    - dataHora : LocalDateTime
    - valor : List~DetalheNumerario~
    + getIdSessaoCaixa() : int
    + getTotal() : double
  }

  class DetalheNumerario {
    - denominacao : Denominacao
    - quantidade : int
    - subtotal : double
    + calcularSubtotal() : double
  }

  enum Denominacao {
    CENTO_EUROS
    CINQUENTA_EUROS
    VINTE_EUROS
    DEZ_EUROS
    CINCO_EUROS
    DOIS_EUROS
    UM_EURO
    CINQUENTA_CENTIMOS
    VINTE_CENTIMOS
    DEZ_CENTIMOS
    CINCO_CENTIMOS
    DOIS_CENTIMOS
    UM_CENTIMO
  }

  class FechoDia {
    - id : int
    - dataFecho : LocalDate
    - estadoEnvio : EstadoSincronizacao
    - idLoja : String
    - idUtilizador : int
    + getDataFecho() : LocalDate
    + getEstadoEnvio() : EstadoSincronizacao
    + getIdLoja() : String
  }
  note bottom of FechoDia
    idLoja obtido de ConfiguracaoTerminal
    pelo FechoDiaServico (RF16, ADR-02).
    Compilação e envio responsabilidade
    do FechoDiaServico, não desta entidade.
  end note

  class LogAuditoria {
    - acao : TipoAcao
    - dataHora : LocalDateTime
    - idUtilizador : int
    - entidade : String
    - idEntidade : int
    + getAcao() : TipoAcao
    + getIdUtilizador() : int
  }

  enum TipoAcao {
    VENDA
    DEVOLUCAO
    ALTERACAO_PRECO
    APLICACAO_DESCONTO
    GESTAO_UTILIZADOR
    ALTERACAO_CATALOGO
  }

  ' --- DTOs ---
  class ProdutoDTO {
    + codigoBarras : String
    + nome : String
    + categoria : String
    + precoBase : double
    + stockMinimo : int
  }

  class RemessaDTO {
    + idFornecedor : int
    + valorTotalGuia : double
    + linhas : List~LinhaRemessaDTO~
  }

  class LinhaRemessaDTO {
    + idProduto : int
    + quantidade : int
    + dataValidade : LocalDate
  }

  class PedidoRemessaDTO {
    + idFornecedor : int
    + linhas : List~LinhaPedidoDTO~
  }

  class LinhaPedidoDTO {
    + idProduto : int
    + quantidadePretendida : int
  }

  class UtilizadorDTO {
    + nomeUtilizador : String
    + palavraPasse : String
    + perfil : PerfilUtilizador
  }
}

