@startuml DS7_Autenticacao_Servidor_Atual
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceParticipantBorderColor #0F6E56
skinparam sequenceParticipantBackgroundColor #E1F5EE
skinparam sequenceActorBorderColor #0F6E56
skinparam sequenceActorBackgroundColor #E1F5EE
skinparam sequenceLifeLineBorderColor #5DCAA5
skinparam sequenceGroupBackgroundColor #F4FBF8
skinparam sequenceGroupBorderColor #5DCAA5
skinparam noteBorderColor #EF9F27
skinparam noteBackgroundColor #FAEEDA

title DS7 — Autenticação do CEO no Servidor Central (Implementação Actual)\nBCrypt + bloqueio por tentativas falhadas + sessão por token

actor "CEO" as C
participant "AuthHandler\n(Javalin)" as AH <<Apresentação>>
participant "SessaoManager" as SM <<Apresentação>>
participant "IAutenticacaoCEOServico" as AS <<Serviço>>
participant "CEORepositorio" as CR <<Repositório>>

== Submissão de credenciais ==
C -> AH : POST /login\n{nomeUtilizador, palavraPasse}
activate AH

AH -> AS : autenticar(nomeUtilizador, palavraPasse)
activate AS

AS -> CR : buscarPorNomeUtilizador(nomeUtilizador)
activate CR
CR --> AS : ceo : CEO | null
deactivate CR

alt utilizador não existe
  AS --> AH : <<lança>> CredenciaisInvalidasException
  AH --> C : 401 Unauthorized\n("Credenciais inválidas")
else conta encontrada

  AS -> AS : estaBloqueado(ceo)
  alt bloqueadoAte >= agora
    AS --> AH : <<lança>> ContaBloqueadaException
    AH --> C : 403 Forbidden\n("Conta bloqueada até HH:MM")
  else não bloqueada

    AS -> AS : BCrypt.checkpw(palavraPasse, hash)
    alt hash não confere
      AS -> AS : registarFalhado(ceo)
      note right of AS
        tentativasLogin++; se ≥ N
        define bloqueadoAte = agora + duração.
      end note
      AS -> CR : atualizar(ceo)
      AS --> AH : <<lança>> CredenciaisInvalidasException
      AH --> C : 401 Unauthorized
    else credenciais válidas
      AS -> AS : limparBloqueio(ceo)
      AS -> CR : atualizar(ceo)

      note over AS, CR
        apagarBootstrapSeNecessario(ceo):
        se este foi o primeiro login com
        uma conta CEO real, a conta
        bootstrap "admin" é eliminada.
      end note
      AS -> AS : apagarBootstrapSeNecessario(ceo)

      AS --> AH : ceo : CEO
      deactivate AS

      == Criação de sessão ==
      AH -> SM : novaSessao(ceo)
      activate SM
      SM --> AH : token
      deactivate SM

      AH --> C : 200 OK\n{token, nomeUtilizador}
    end
  end
end
deactivate AH

== Verificação de token em pedidos subsequentes ==
C -> AH : GET /qualquer\n(Authorization: Bearer <token>)
activate AH
AH -> SM : verificarToken(token)
SM --> AH : ceo | null
alt token válido
  AH --> C : 200 OK
else inválido / expirado
  AH --> C : 401 Unauthorized
end
deactivate AH

== Logout ==
C -> AH : POST /logout
activate AH
AH -> SM : invalidar(token)
AH --> C : 200 OK
deactivate AH

@enduml
