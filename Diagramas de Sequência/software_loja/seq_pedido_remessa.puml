@startuml seq_pedido_remessa
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 160
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #534AB7
skinparam sequenceParticipantBackgroundColor #EEEDFE
skinparam sequenceActorBorderColor #534AB7
skinparam sequenceActorBackgroundColor #EEEDFE
skinparam sequenceLifeLineBorderColor #534AB7
skinparam sequenceGroupBorderColor #888888
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam noteBorderColor #534AB7
skinparam noteBackgroundColor #FFFDE7
skinparam sequenceDividerBorderColor #534AB7
skinparam sequenceDividerBackgroundColor #EEF4FF

title Diagrama de Sequência — Processo de Pedido de Remessa (Software de Loja)

actor "Gestor / CEO" as Actor

participant "RemessaController"          as Controller      #EEF4FF
participant "RemessaServico"             as Servico         #EEF9F4
participant "CatalogoServico"            as CatalogoServ    #EEF9F4
participant "AutorizacaoServico"         as AutorizServ     #EEF9F4
participant "AuditoriaServico"           as AuditServ       #EEF9F4
participant "ProdutoRepositorio"         as ProdRepo        #FFF8EE
participant "LoteRepositorio"            as LoteRepo        #FFF8EE
participant "PedidoRemessaRepositorio"   as PedidoRepo      #FFF8EE
participant "RemessaRepositorio"         as RemessaRepo     #FFF8EE
participant "PagamentoRepositorio"       as PagamentoRepo   #FFF8EE
participant "LogAuditoriaRepositorio"    as LogRepo         #FFF8EE
participant "Produto"                    as Produto         #FEFEFE
participant "Lote"                       as Lote            #FEFEFE
participant "PedidoRemessa"              as PedidoRemessa   #FEFEFE
participant "LinhaPedidoRemessa"         as LinhaPedido     #FEFEFE
participant "Remessa"                    as Remessa         #FEFEFE
participant "LinhaRemessa"               as LinhaRemessa    #FEFEFE
participant "Pagamento"                  as Pagamento       #FEFEFE

== Consulta de Alertas de Stock (pré-condição) ==

note over Actor, CatalogoServ
    O Gestor consulta alertas de stock mínimo
    antes de criar o pedido de remessa
end note

Actor -> Controller : onConsultarAlertas()
activate Controller

Controller -> AutorizServ : exigirPerfil(utilizador, [GESTOR, CEO])
activate AutorizServ
alt perfil não autorizado
    AutorizServ --> Controller : throw AcessoNegadoException
    Controller --> Actor : apresentar mensagem "Acesso negado"
    deactivate AutorizServ
else autorizado
    AutorizServ --> Controller : void
    deactivate AutorizServ

    Controller -> CatalogoServ : gerarAlertasStockMinimo()
    activate CatalogoServ

    CatalogoServ -> ProdRepo : buscarAbaixoStockMinimo()
    activate ProdRepo
    ProdRepo --> CatalogoServ : produtos : List<Produto>
    deactivate ProdRepo

    CatalogoServ --> Controller : produtos : List<Produto>
    deactivate CatalogoServ

    Controller --> Actor : apresentar lista de produtos abaixo do stock mínimo
end

deactivate Controller

== Criação do Pedido de Remessa ==

Actor -> Controller : onCriarPedidoRemessa(dadosPedido : PedidoRemessaDTO)
activate Controller

Controller -> AutorizServ : exigirPerfil(utilizador, [GESTOR, CEO])
activate AutorizServ
alt perfil não autorizado
    AutorizServ --> Controller : throw AcessoNegadoException
    Controller --> Actor : apresentar mensagem "Acesso negado"
    deactivate AutorizServ
else autorizado
    AutorizServ --> Controller : void
    deactivate AutorizServ

    Controller -> Servico : criarPedidoRemessa(\n  utilizador, fornecedor,\n  linhas : List<LinhaPedidoRemessa>)
    activate Servico

    alt fornecedor não encontrado ou inactivo
        Servico --> Controller : throw FornecedorInvalidoException
        Controller --> Actor : apresentar mensagem "Fornecedor inválido"

    else fornecedor válido

        alt pedido sem linhas
            Servico --> Controller : throw PedidoVazioException
            Controller --> Actor : apresentar mensagem "O pedido deve ter pelo menos um produto"

        else pedido com linhas

            Servico -> PedidoRemessa ** : new PedidoRemessa(\n  fornecedor, utilizador, PENDENTE)
            activate PedidoRemessa
            deactivate PedidoRemessa

            loop para cada linha do pedido

                Servico -> ProdRepo : buscarPorId(linha.getIdProduto())
                activate ProdRepo
                ProdRepo --> Servico : produto : Produto | null
                deactivate ProdRepo

                alt produto não encontrado
                    Servico --> Controller : throw ProdutoNaoEncontradoException
                    Controller --> Actor : apresentar mensagem "Produto inválido na linha do pedido"

                else produto válido

                    Servico -> Produto : isAtivo()
                    activate Produto
                    Produto --> Servico : boolean
                    deactivate Produto

                    alt produto inativo
                        Servico --> Controller : throw ProdutoInativoException
                        Controller --> Actor : apresentar mensagem "Produto descontinuado"
                    else produto ativo

                        Servico -> LinhaPedido ** : new LinhaPedidoRemessa(\n  pedido, produto,\n  quantidadePretendida)
                        activate LinhaPedido
                        deactivate LinhaPedido

                        Servico -> PedidoRemessa : adicionarLinha(linhaPedido)
                        activate PedidoRemessa
                        deactivate PedidoRemessa
                    end
                end
            end

            Servico -> PedidoRepo : guardar(pedidoRemessa)
            activate PedidoRepo
            PedidoRepo --> Servico : void
            deactivate PedidoRepo

            Servico -> AuditServ : registar(\n  utilizador, ALTERACAO_CATALOGO,\n  "PedidoRemessa", pedidoRemessa.getId())
            activate AuditServ
            AuditServ -> LogRepo : guardar(logAuditoria)
            activate LogRepo
            LogRepo --> AuditServ : void
            deactivate LogRepo
            AuditServ --> Servico : void
            deactivate AuditServ

            Servico --> Controller : pedidoRemessa : PedidoRemessa
            deactivate Servico

            Controller --> Actor : apresentar confirmação do pedido criado
        end
    end
end

deactivate Controller

== Registo da Remessa Recebida (resposta ao pedido) ==

note over Actor, RemessaRepo
    O Gestor regista a remessa quando a
    mercadoria chega fisicamente à loja
end note

Actor -> Controller : onRegistarRemessa(dadosRemessa : RemessaDTO)
activate Controller

Controller -> AutorizServ : exigirPerfil(utilizador, [GESTOR, CEO])
activate AutorizServ
alt perfil não autorizado
    AutorizServ --> Controller : throw AcessoNegadoException
    Controller --> Actor : apresentar mensagem "Acesso negado"
    deactivate AutorizServ
else autorizado
    AutorizServ --> Controller : void
    deactivate AutorizServ

    Controller -> Servico : registarRemessa(\n  utilizador, fornecedor,\n  linhas, valorTotalGuia)
    activate Servico

    Servico -> Remessa ** : new Remessa(\n  fornecedor, utilizador,\n  valorTotalGuia)
    activate Remessa
    note right of Remessa
        estadoSincronizacao = PENDENTE
        idLoja de ConfiguracaoTerminal
    end note
    deactivate Remessa

    loop para cada linha da remessa recebida

        Servico -> ProdRepo : buscarPorId(linha.getIdProduto())
        activate ProdRepo
        ProdRepo --> Servico : produto : Produto
        deactivate ProdRepo

        Servico -> Lote ** : new Lote(\n  produto, quantidade,\n  dataValidade, precoVenda)
        activate Lote
        note right of Lote
            Novo lote gerado
            automaticamente para
            cada linha da remessa
        end note
        deactivate Lote

        Servico -> LoteRepo : guardar(lote)
        activate LoteRepo
        LoteRepo --> Servico : void
        deactivate LoteRepo

        Servico -> LinhaRemessa ** : new LinhaRemessa(\n  remessa, produto,\n  lote, quantidade, dataValidade)
        activate LinhaRemessa
        deactivate LinhaRemessa

        Servico -> Remessa : adicionarLinha(linhaRemessa)
        activate Remessa
        deactivate Remessa
    end

    Servico -> RemessaRepo : guardar(remessa)
    activate RemessaRepo
    RemessaRepo --> Servico : void
    deactivate RemessaRepo

    == Associação ao Pedido Pendente ==

    Servico -> Servico : associarPedidoPendente(remessa)
    activate Servico

    Servico -> PedidoRepo : buscarPendentesPorFornecedor(\n  fornecedor.getId())
    activate PedidoRepo
    PedidoRepo --> Servico : pedidos : List<PedidoRemessa>
    deactivate PedidoRepo

    opt existe pedido pendente para este fornecedor
        Servico -> PedidoRemessa : estado = CONCLUIDO
        activate PedidoRemessa
        deactivate PedidoRemessa

        Servico -> PedidoRepo : atualizar(pedidoRemessa)
        activate PedidoRepo
        PedidoRepo --> Servico : void
        deactivate PedidoRepo

        note right of Servico
            Associa automaticamente
            a remessa recebida ao
            pedido pendente do
            mesmo fornecedor
        end note
    end

    deactivate Servico

    == Criação do Pagamento Pendente ==

    Servico -> Pagamento ** : new Pagamento(\n  fornecedor, remessa,\n  valorTotalGuia, PENDENTE)
    activate Pagamento
    note right of Pagamento
        estadoSincronizacao = PENDENTE
        Pagamento criado como pendente —
        será liquidado pelo PagamentoServico
    end note
    deactivate Pagamento

    Servico -> PagamentoRepo : guardar(pagamento)
    activate PagamentoRepo
    PagamentoRepo --> Servico : void
    deactivate PagamentoRepo

    == Auditoria ==

    Servico -> AuditServ : registar(\n  utilizador, ALTERACAO_CATALOGO,\n  "Remessa", remessa.getId())
    activate AuditServ
    AuditServ -> LogRepo : guardar(logAuditoria)
    activate LogRepo
    LogRepo --> AuditServ : void
    deactivate LogRepo
    AuditServ --> Servico : void
    deactivate AuditServ

    Servico --> Controller : remessa : Remessa
    deactivate Servico

    Controller --> Actor : apresentar confirmação da remessa registada\ne pagamento pendente criado
end

deactivate Controller

@enduml
