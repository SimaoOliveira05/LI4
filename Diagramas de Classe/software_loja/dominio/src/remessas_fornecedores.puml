@startuml Software_de_Loja_Parte4b_Dominio_Remessas_Fornecedores
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #EEEDFE
skinparam classBorderColor #534AB7
skinparam classBackgroundColor #FAFAFA
skinparam arrowColor #534AB7
skinparam stereotypeCBackgroundColor #E1F5EE
skinparam stereotypeABackgroundColor #FAC775
skinparam stereotypeIBackgroundColor #D1ECF1
skinparam packageBackgroundColor #F8F8F8
skinparam packageBorderColor #B4B2A9
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 50

title Software de Loja — Domínio (Remessas, Fornecedores e Pagamentos)

package "Remessas e Fornecedores" #FEFEFE {

  class Fornecedor {
    - id : int
    - nome : String
    - nif : String
    - morada : String
    - telefone : String
    - email : String
    - iban : String
    + getId() : int
    + getNome() : String
    + getIban() : String
  }

  enum EstadoPedido {
    PENDENTE
    CONCLUIDO
  }

  class PedidoRemessa {
    - id : int
    - idFornecedor : int
    - idUtilizador : int
    - dataCriacao : LocalDate
    - estado : EstadoPedido
    + getIdFornecedor() : int
    + getEstado() : EstadoPedido
    + estaPendente() : boolean
  }

  class LinhaPedidoRemessa {
    - id : int
    - idPedido : int
    - idProduto : int
    - quantidadePretendida : int
    + getIdProduto() : int
    + getQuantidadePretendida() : int
  }

  class Remessa {
    - dataRecepcao : LocalDate
    - valorTotalGuia : double
    - idFornecedor : int
    - idUtilizador : int
    + getIdFornecedor() : int
    + getDataRecepcao() : LocalDate
    + getValorTotalGuia() : double
  }

  class LinhaRemessa {
    - id : int
    - idRemessa : int
    - idProduto : int
    - idLoteGerado : int
    - quantidade : int
    - dataValidade : LocalDate
    + getIdProduto() : int
    + getIdLoteGerado() : int
    + getQuantidade() : int
  }

  enum TipoPagamento {
    TRANSFERENCIA
    NUMERARIO
    CHEQUE
  }

  class Pagamento {
    - valor : double
    - dataPagamento : LocalDate
    - tipoPagamento : TipoPagamento
    - idFornecedor : int
    - idRemessa : int
    - idUtilizador : int
    + getIdFornecedor() : int
    + getIdRemessa() : int
    + getTipoPagamento() : TipoPagamento
  }
}

' Relações
PedidoRemessa "1" *-- "1..*" LinhaPedidoRemessa : linhas
Remessa "1" *-- "1..*" LinhaRemessa : linhas
Remessa --> Fornecedor : idFornecedor
PedidoRemessa --> Fornecedor : idFornecedor
Pagamento --> Remessa : idRemessa
Pagamento --> Fornecedor : idFornecedor
PedidoRemessa --> EstadoPedido
Pagamento --> TipoPagamento

@enduml