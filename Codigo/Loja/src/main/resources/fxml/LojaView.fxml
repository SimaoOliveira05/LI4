<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.trasmum.loja.apresentacao.controllers.LojaController"
      spacing="16" styleClass="view-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Configuração da Loja" styleClass="view-title"/>

    <GridPane hgap="16" vgap="10">
        <Label text="Identificador:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="section-title"/>
        <Label fx:id="lblId"         GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Nome:"          GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="section-title"/>
        <TextField fx:id="fNome"     GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="340"/>

        <Label text="Morada:"        GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="section-title"/>
        <TextField fx:id="fMorada"   GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="340"/>

        <Label text="Localidade:"    GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="section-title"/>
        <TextField fx:id="fLocalidade" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="340"/>

        <Label text="NIF:"           GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="section-title"/>
        <TextField fx:id="fNif"      GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="340"/>

        <Label text="E-mail:"        GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="section-title"/>
        <TextField fx:id="fEmail"    GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="340"/>

        <Label text="Limite máximo de caixa (€):" GridPane.columnIndex="0" GridPane.rowIndex="6" styleClass="section-title"/>
        <TextField fx:id="fLimiteCaixa"            GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="340"/>

        <Label text="Alerta de validade (dias):"  GridPane.columnIndex="0" GridPane.rowIndex="7" styleClass="section-title"/>
        <TextField fx:id="fDiasValidade"           GridPane.columnIndex="1" GridPane.rowIndex="7" prefWidth="340"/>
    </GridPane>

    <HBox spacing="8">
        <Button text="Guardar alterações" onAction="#onGuardar" styleClass="btn-primary"/>
    </HBox>
</VBox>
