@startuml servicos_tesouraria_caixa
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #EEEDFE
skinparam classBorderColor #534AB7
skinparam classBackgroundColor #FAFAFA
skinparam arrowColor #534AB7
skinparam stereotypeCBackgroundColor #E1F5EE
skinparam stereotypeABackgroundColor #FAC775
skinparam stereotypeIBackgroundColor #D1ECF1
skinparam packageBackgroundColor #F8F8F8
skinparam packageBorderColor #B4B2A9
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50

title Software de Loja — Serviços (Módulo: Tesouraria e Caixa)

package "Serviço (Interface - Tesouraria e Caixa)" #E0F0E0 {

  interface ICaixaServico {
    + abrirSessao(utilizador : Utilizador, fundo : List<DetalheNumerario>, configuracao : ConfiguracaoTerminal) : SessaoCaixa
    + registarSangria(sessao : SessaoCaixa, utilizador : Utilizador, valor : List<DetalheNumerario>) : Sangria
    + fecharSessao(sessao : SessaoCaixa) : void
    + verificarLimite(sessao : SessaoCaixa, configuracao : ConfiguracaoTerminal) : boolean
    + obterSessoesPendentes() : List<SessaoCaixa>
  }
}

package "Serviço (Implementação - Tesouraria e Caixa)" #EEF9F4 {

  class CaixaServico {
    - sessaoCaixaRepositorio : SessaoCaixaRepositorio
    - auditoriaServico : IAuditoriaServico
    - autorizacaoServico : IAutorizacaoServico

    + abrirSessao(utilizador : Utilizador, fundo : List<DetalheNumerario>, configuracao : ConfiguracaoTerminal) : SessaoCaixa
    + registarSangria(sessao : SessaoCaixa, utilizador : Utilizador, valor : List<DetalheNumerario>) : Sangria
    + fecharSessao(sessao : SessaoCaixa) : void
    + verificarLimite(sessao : SessaoCaixa, configuracao : ConfiguracaoTerminal) : boolean
    + obterSessoesPendentes() : List<SessaoCaixa>
  }
}

' Implementação realiza interface
CaixaServico ..|> ICaixaServico

' Relações com Repositórios
CaixaServico ..> SessaoCaixaRepositorio

' Serviços transversais
CaixaServico ..> IAutorizacaoServico
CaixaServico ..> IAuditoriaServico

@enduml
