<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.trasmum.loja.apresentacao.controllers.PagamentoController"
      spacing="12" styleClass="view-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Pagamentos a Fornecedores" styleClass="view-title"/>

    <HBox spacing="8">
        <Button text="Liquidar"  onAction="#onLiquidar"  styleClass="btn-primary"/>
        <Button text="Refrescar" onAction="#onRefrescar" styleClass="btn-secondary"/>
    </HBox>

    <TableView fx:id="tblPagamentos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"         text="ID"          prefWidth="60"/>
            <TableColumn fx:id="colFornecedor" text="Fornecedor"  prefWidth="120"/>
            <TableColumn fx:id="colValor"      text="Valor (€)"   prefWidth="110"/>
            <TableColumn fx:id="colEstado"     text="Estado"      prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
