@startuml DS6_Registo_Remessa
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceParticipantBorderColor #993C1D
skinparam sequenceParticipantBackgroundColor #FAECE7
skinparam sequenceActorBorderColor #993C1D
skinparam sequenceActorBackgroundColor #FAECE7
skinparam sequenceLifeLineBorderColor #F0997B
skinparam sequenceGroupBackgroundColor #FDF6F4
skinparam sequenceGroupBorderColor #F0997B
skinparam noteBorderColor #534AB7
skinparam noteBackgroundColor #EEEDFE

title DS6 — Registo de Remessa (RF6, RF7)

actor "Gestor" as G
participant "RemessaController" as RC <<Apresentação>>
participant "IAutorizacaoServico" as AZ <<Serviço>>
participant "IRemessaServico" as RS <<Serviço>>
participant "IAuditoriaServico" as AU <<Serviço>>
participant "ProdutoRepositorio" as PR <<Repositório>>
participant "LoteRepositorio" as LR <<Repositório>>
participant "RemessaRepositorio" as RR <<Repositório>>
participant "PedidoRemessaRepositorio" as PRR <<Repositório>>
participant "PagamentoRepositorio" as PAR <<Repositório>>

== Autorização (RF6) ==

G -> RC : onRegistarRemessa(dados : RemessaDTO)
activate RC

RC -> AZ : exigirPerfil(utilizador, GESTOR, CEO)
activate AZ
AZ --> RC : ok
deactivate AZ

RC -> RS : registarRemessa(utilizador, fornecedor,\nlinhas, valorTotalGuia)
activate RS

== Validação das linhas da remessa ==

alt linhas vazias
  RS --> RC : <<lança>> RemessaSemLinhasException
  RC --> G : alerta — "A remessa deve conter\npelo menos uma linha"
else linhas válidas

  == Criação dos lotes por linha recebida (RF6) ==

  loop para cada LinhaRemessa

    RS -> PR : buscarPorCodigoBarras(linha.idProduto)
    activate PR

    alt produto não encontrado ou inativo
      PR --> RS : null
      RS --> RC : <<lança>> ProdutoNaoEncontradoException
      RC --> G : alerta — "Produto desconhecido\nna linha da remessa"
    else produto válido
      PR --> RS : produto : Produto
      deactivate PR

      note over RS, LR
        Para cada linha da remessa é criado um Lote
        independente com a data de validade da entrega
        e a quantidade recebida, sem sobrepor lotes
        pré-existentes do mesmo produto (RF6).
        O idLoteGerado é registado na LinhaRemessa
        para rastreabilidade.
      end note

      RS -> LR : guardar(lote)
      activate LR
      LR --> RS : idLote : int
      deactivate LR

    end
  end

  == Persistência da remessa ==

  RS -> RR : guardar(remessa)
  activate RR
  RR --> RS : ok
  deactivate RR

  == Associação a pedido pendente (RF7) ==

  RS -> RS : associarPedidoPendente(remessa)

  note over RS
    Verifica se existe um PedidoRemessa PENDENTE
    para o mesmo fornecedor. Se existir, actualiza
    o seu estado para CONCLUIDO. Se não existir,
    a remessa é registada sem associação a pedido
    (RF7).
  end note

  RS -> PRR : buscarPendentesPorFornecedor(remessa.idFornecedor)
  activate PRR
  PRR --> RS : pedidos : List<PedidoRemessa>
  deactivate PRR

  alt existe pedido pendente para o fornecedor
    RS -> PRR : atualizar(pedido — estado CONCLUIDO)
    activate PRR
    PRR --> RS : ok
    deactivate PRR
  else sem pedido pendente
    note over RS
      Remessa registada sem associação
      a pedido de encomenda.
    end note
  end

  == Geração do pagamento pendente (RF6) ==

  note over RS, PAR
    A receção de uma remessa gera automaticamente
    um registo de Pagamento com estado PENDENTE
    associado ao fornecedor e ao valor da guia,
    para posterior liquidação pelo gestor (RF6, RF18).
  end note

  RS -> PAR : guardar(pagamento — estado PENDENTE)
  activate PAR
  PAR --> RS : ok
  deactivate PAR

  == Registo de auditoria ==

  RS -> AU : registar(utilizador, ALTERACAO_CATALOGO,\n"Remessa", remessa.getId())
  activate AU
  AU --> RS : ok
  deactivate AU

  RS --> RC : remessa : Remessa
  deactivate RS

  RC --> G : confirmação — "Remessa registada.\nPagamento pendente gerado."
  deactivate RC

end

@enduml
