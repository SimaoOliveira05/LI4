@startuml seq_registo_venda
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 160
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #534AB7
skinparam sequenceParticipantBackgroundColor #EEEDFE
skinparam sequenceActorBorderColor #534AB7
skinparam sequenceActorBackgroundColor #EEEDFE
skinparam sequenceLifeLineBorderColor #534AB7
skinparam sequenceGroupBorderColor #888888
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam noteBorderColor #534AB7
skinparam noteBackgroundColor #FFFDE7
skinparam sequenceDividerBorderColor #534AB7
skinparam sequenceDividerBackgroundColor #EEF4FF

title Diagrama de Sequência — Registo de Venda (Software de Loja)

actor "Funcionário" as Actor

participant "VendaController"        as Controller  #EEF4FF
participant "VendaServico"           as Servico     #EEF9F4
participant "AutorizacaoServico"     as AutorizServ #EEF9F4
participant "AuditoriaServico"       as AuditServ   #EEF9F4
participant "ProdutoRepositorio"     as ProdRepo    #FFF8EE
participant "LoteRepositorio"        as LoteRepo    #FFF8EE
participant "VendaRepositorio"       as VendaRepo   #FFF8EE
participant "FaturaRepositorio"      as FaturaRepo  #FFF8EE
participant "SessaoCaixaRepositorio" as CaixaRepo   #FFF8EE
participant "LogAuditoriaRepositorio" as LogRepo    #FFF8EE
participant "Venda"                  as Venda       #FEFEFE
participant "LinhaVenda"             as LinhaVenda  #FEFEFE
participant "Fatura"                 as Fatura      #FEFEFE
participant "Lote"                   as Lote        #FEFEFE

== Iniciação da Venda ==

Actor -> Controller : onLerCodigoBarras(codigo)
activate Controller

Controller -> AutorizServ : exigirPerfil(utilizador, [FUNCIONARIO, GESTOR, CEO])
activate AutorizServ
alt perfil não autorizado
    AutorizServ --> Controller : throw AcessoNegadoException
    Controller --> Actor : apresentar mensagem "Acesso negado"
    deactivate AutorizServ
else perfil autorizado
    AutorizServ --> Controller : void
    deactivate AutorizServ

    Controller -> CaixaRepo : buscarSessaoAtiva(utilizador.getId())
    activate CaixaRepo
    CaixaRepo --> Controller : sessao : SessaoCaixa | null
    deactivate CaixaRepo

    alt sessão de caixa não existe
        Controller --> Actor : apresentar mensagem "Caixa não está aberta"
    else sessão de caixa activa

        Controller -> Servico : iniciarVenda(utilizador)
        activate Servico

        Servico -> Venda ** : new Venda(utilizador.getId(), EM_CURSO)
        activate Venda
        note right of Venda
            idLoja copiado de
            ConfiguracaoTerminal
            estadoSincronizacao = PENDENTE
        end note
        deactivate Venda

        Servico -> VendaRepo : guardar(venda)
        activate VendaRepo
        VendaRepo --> Servico : void
        deactivate VendaRepo

        Servico --> Controller : venda : Venda
        deactivate Servico

        Controller --> Actor : apresentar ecrã de venda activa

        == Adição de Linhas (ciclo por artigo lido) ==

        loop para cada código de barras lido pelo operador

            Actor -> Controller : onAdicionarLinha(codigo, quantidade)

            Controller -> Servico : adicionarLinha(venda, codigo, quantidade)
            activate Servico

            Servico -> ProdRepo : buscarPorCodigoBarras(codigo)
            activate ProdRepo
            ProdRepo --> Servico : produto : Produto | null
            deactivate ProdRepo

            alt produto não encontrado ou inativo
                Servico --> Controller : throw ProdutoNaoEncontradoException
                Controller --> Actor : apresentar mensagem "Produto não encontrado"

            else produto encontrado e ativo

                Servico -> LoteRepo : buscarLotesFEFO(produto.getId())
                activate LoteRepo
                LoteRepo --> Servico : lotes : List<Lote>
                deactivate LoteRepo

                note right of Servico
                    Selecção FEFO:
                    consome lotes por ordem
                    crescente de dataValidade
                end note

                alt lotes insuficientes para satisfazer quantidade
                    Servico --> Controller : throw StockInsuficienteException\n(nomeProduto, solicitada, disponivel)
                    Controller --> Actor : apresentar mensagem "Stock insuficiente:\ndisponível X unidades"

                else stock suficiente

                    loop para cada lote consumido (FEFO)
                        Servico -> Lote : getQuantidade()
                        activate Lote
                        Lote --> Servico : int
                        deactivate Lote

                        Servico -> Lote : quantidade -= consumido
                        activate Lote
                        deactivate Lote

                        Servico -> LoteRepo : atualizar(lote)
                        activate LoteRepo
                        LoteRepo --> Servico : void
                        deactivate LoteRepo
                    end

                    Servico -> LinhaVenda ** : new LinhaVenda(venda, lote, quantidade, precoUnitario)
                    activate LinhaVenda
                    deactivate LinhaVenda

                    Servico -> Venda : adicionarLinha(linhaVenda)
                    activate Venda
                    Venda --> Servico : void
                    deactivate Venda

                    Servico --> Controller : linhaVenda : LinhaVenda
                    Controller --> Actor : actualizar total e lista de linhas no ecrã
                end
            end
            deactivate Servico
        end

        == Finalização da Venda ==

        Actor -> Controller : onFinalizarVenda(metodo, valorEntregue)
        activate Servico

        Controller -> Servico : finalizarVenda(venda, metodo, valorEntregue)

        Servico -> Venda : getTotalFaturado()
        activate Venda
        Venda --> Servico : double
        deactivate Venda

        Servico -> Servico : calcularTroco(total, valorEntregue)

        alt valorEntregue < total
            Servico --> Controller : throw PagamentoInsuficienteException
            Controller --> Actor : apresentar mensagem "Valor entregue insuficiente"

        else pagamento suficiente

            Servico -> Venda : estado = FINALIZADA\nmetodoPagamento = metodo
            activate Venda
            deactivate Venda

            Servico -> Fatura ** : new Fatura(venda)
            activate Fatura
            note right of Fatura
                numeroFatura gerado
                automaticamente (RF5)
            end note
            deactivate Fatura

            Servico -> VendaRepo : guardar(venda)
            activate VendaRepo
            VendaRepo --> Servico : void
            deactivate VendaRepo

            Servico -> FaturaRepo : guardar(fatura)
            activate FaturaRepo
            FaturaRepo --> Servico : void
            deactivate FaturaRepo

            Servico -> AuditServ : registar(utilizador, VENDA, "Venda", venda.getId())
            activate AuditServ

            AuditServ -> LogRepo : guardar(logAuditoria)
            activate LogRepo
            LogRepo --> AuditServ : void
            deactivate LogRepo

            AuditServ --> Servico : void
            deactivate AuditServ

            Servico --> Controller : fatura : Fatura
            deactivate Servico

            Controller --> Actor : apresentar fatura e troco
        end
    end
end

deactivate Controller

== Anulação de Venda (fluxo alternativo) ==

Actor -> Controller : onAnularVenda()
activate Controller

Controller -> AutorizServ : exigirPerfil(utilizador, [GESTOR, CEO])
activate AutorizServ
alt perfil não autorizado
    AutorizServ --> Controller : throw AcessoNegadoException
    Controller --> Actor : apresentar mensagem "Apenas Gestor ou CEO podem anular vendas"
    deactivate AutorizServ
else autorizado
    AutorizServ --> Controller : void
    deactivate AutorizServ

    Controller -> Servico : anularVenda(venda)
    activate Servico

    Servico -> Venda : estado = ANULADA
    activate Venda
    deactivate Venda

    loop para cada linhaVenda da venda anulada
        Servico -> LoteRepo : atualizar(lote) ' repor stock
        activate LoteRepo
        LoteRepo --> Servico : void
        deactivate LoteRepo
    end

    Servico -> VendaRepo : guardar(venda)
    activate VendaRepo
    VendaRepo --> Servico : void
    deactivate VendaRepo

    Servico -> AuditServ : registar(utilizador, VENDA, "Venda", venda.getId())
    activate AuditServ
    AuditServ -> LogRepo : guardar(logAuditoria)
    activate LogRepo
    LogRepo --> AuditServ : void
    deactivate LogRepo
    AuditServ --> Servico : void
    deactivate AuditServ

    Servico --> Controller : void
    deactivate Servico

    Controller --> Actor : apresentar mensagem "Venda anulada com sucesso"
end

deactivate Controller

@enduml
