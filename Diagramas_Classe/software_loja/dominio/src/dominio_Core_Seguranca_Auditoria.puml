@startuml Software_de_Loja_Dominio_Core_Auditoria
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #EEEDFE
skinparam classBorderColor #534AB7
skinparam classBackgroundColor #FAFAFA
skinparam arrowColor #534AB7
skinparam stereotypeCBackgroundColor #E1F5EE
skinparam stereotypeABackgroundColor #FAC775
skinparam stereotypeIBackgroundColor #D1ECF1
skinparam packageBackgroundColor #F8F8F8
skinparam packageBorderColor #B4B2A9
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 50

title Software de Loja — Domínio (Módulo: Core, Segurança e Auditoria)

package "Core e Segurança" #FEFEFE {

  class ConfiguracaoTerminal {
    - idLoja : String
    - nomeLoja : String
    - limiteMaximoCaixa : double
    + getIdLoja() : String
    + getNomeLoja() : String
    + getLimiteMaximoCaixa() : double
  }

  abstract class RegistoSincronizavel {
    # id : int
    # estadoSincronizacao : EstadoSincronizacao
    # idLoja : String
    + getEstadoSincronizacao() : EstadoSincronizacao
    + marcarEmTransito() : void
    + marcarConfirmado() : void
    + reverterParaPendente() : void
  }

  enum EstadoSincronizacao {
    PENDENTE, EM_TRANSITO, CONFIRMADO
  }

  class Utilizador {
    - id : int
    - nomeUtilizador : String
    - hashPalavraPasse : String
    - perfil : PerfilUtilizador
    - ativo : boolean
    - emSessao : boolean
    + getId() : int
    + getPerfil() : PerfilUtilizador
    + isAtivo() : boolean
    + isEmSessao() : boolean
  }

  enum PerfilUtilizador {
    FUNCIONARIO, GESTOR, CEO
  }
}

package "Auditoria" #FEFEFE {

  enum TipoAcao {
    VENDA, DEVOLUCAO, ALTERACAO_PRECO,
    APLICACAO_DESCONTO, GESTAO_UTILIZADOR,
    ALTERACAO_CATALOGO, FECHO_DIA
  }

  class LogAuditoria {
    - id : int
    - acao : TipoAcao
    - dataHora : LocalDateTime
    - idUtilizador : int
    - entidade : String
    - idEntidade : int
    + getAcao() : TipoAcao
    + getIdUtilizador() : int
  }
}

' Herança sincronizável
RegistoSincronizavel <|-- LogAuditoria

' Relações Core
Utilizador --> PerfilUtilizador
RegistoSincronizavel --> EstadoSincronizacao
LogAuditoria --> TipoAcao

' Relação com Utilizador (Fraco acoplamento)
LogAuditoria --> Utilizador : idUtilizador

@enduml
