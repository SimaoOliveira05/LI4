<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           styleClass="view-root">
    <TabPane tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="Utilizadores">
                <content>
                    <fx:include source="UtilizadorView.fxml"/>
                </content>
            </Tab>
            <Tab text="Auditoria">
                <content>
                    <fx:include source="LogAuditoriaView.fxml"/>
                </content>
            </Tab>
            <Tab text="Loja">
                <content>
                    <fx:include source="LojaView.fxml"/>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</StackPane>
