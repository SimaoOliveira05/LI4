@startuml DS4_Recepcao_Servidor_Atual
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceParticipantBorderColor #0F6E56
skinparam sequenceParticipantBackgroundColor #E1F5EE
skinparam sequenceActorBorderColor #0F6E56
skinparam sequenceActorBackgroundColor #E1F5EE
skinparam sequenceLifeLineBorderColor #5DCAA5
skinparam sequenceGroupBackgroundColor #F4FBF8
skinparam sequenceGroupBorderColor #5DCAA5
skinparam noteBorderColor #EF9F27
skinparam noteBackgroundColor #FAEEDA

title DS4 — Ingestão do Pacote no Servidor Central (Implementação Actual)\nTransacção JDBC única com Connection partilhada

participant "Software\nde Loja\n(HTTP Client)" as SL <<Externo>>
participant "IngestaoHandler\n(Javalin)" as IH <<Apresentação>>
participant "IIngestaoServico" as IS <<Serviço>>
participant "DatabaseConnection" as DB <<Infra>>
participant "LojaRepositorio" as LR <<Repositório>>
participant "FechoDiaCentralRepositorio" as FDR <<Repositório>>
participant "VendaCentralRepositorio" as VCR <<Repositório>>
participant "DevolucaoCentralRepositorio" as DCR <<Repositório>>
participant "RemessaCentralRepositorio" as RCR <<Repositório>>
participant "PagamentoCentralRepositorio" as PCR <<Repositório>>
participant "SessaoCaixaCentralRepositorio" as SCR <<Repositório>>
participant "LogAuditoriaCentralRepositorio" as LACR <<Repositório>>

== Recepção e validação ==
SL -> IH : POST /fecho\n(PacoteFechoDTO — JSON)
activate IH

IH -> IS : processarPacote(pacote)
activate IS

IS -> IS : verificarHash(pacote)
note right of IS
  SHA-256 sobre o conteúdo
  serializado do pacote.
end note

alt hash inválido / JSON malformado
  IS --> IH : <<lança>> IntegridadeInvalidaException
  IH --> SL : 400 Bad Request
else pacote íntegro

  == Abertura de transacção ==
  IS -> DB : obter() : Connection
  activate DB
  DB --> IS : conn
  deactivate DB
  IS -> IS : conn.setAutoCommit(false)

  note over IS
    A persistência do pacote inteiro é feita
    como uma única transacção JDBC. A mesma
    Connection é passada a cada repositório
    via guardar(Connection, ...).
    Falha em qualquer passo ⇒ rollback total.
  end note

  == Resolução / criação da Loja ==
  IS -> LR : criarSeNaoExistir(conn, new Loja(idLoja, nomeLoja))

  == Persistência do FechoDiaCentral ==
  IS -> FDR : guardar(conn, fechoDia)

  == Persistência das colecções (idempotência por chave composta) ==
  loop cada VendaDTO
    IS -> VCR : guardar(conn, vendaCentral)
  end
  loop cada DevolucaoDTO
    IS -> DCR : guardar(conn, devolucaoCentral)
  end
  loop cada RemessaDTO
    IS -> RCR : guardar(conn, remessaCentral)
  end
  loop cada PagamentoDTO
    IS -> PCR : guardar(conn, pagamentoCentral)
    alt pagamento com dataPagamento != null
      IS -> RCR : atualizarEstadoPagamento(conn, idLoja,\nidOriginalRemessa, PAGA)
    end
  end
  loop cada SessaoCaixaDTO
    IS -> SCR : guardar(conn, sessaoCaixaCentral)
  end
  loop cada LogAuditoriaDTO
    IS -> LACR : guardar(conn, logCentral)
  end

  == Commit / rollback ==
  alt qualquer SQLException
    IS -> IS : conn.rollback()
    IS --> IH : <<lança>> RuntimeException
    IH --> SL : 500 Internal Server Error
  else tudo bem
    IS -> IS : conn.commit()
    IS --> IH : ok
    deactivate IS
    IH --> SL : 200 OK\n(ACK — idLoja, dataFecho)
  end
end
deactivate IH

@enduml
