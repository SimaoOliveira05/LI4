@startuml DS3_Fecho_Loja
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceParticipantBorderColor #534AB7
skinparam sequenceParticipantBackgroundColor #EEEDFE
skinparam sequenceActorBorderColor #534AB7
skinparam sequenceActorBackgroundColor #EEEDFE
skinparam sequenceLifeLineBorderColor #AFA9EC
skinparam sequenceGroupBackgroundColor #F8F8FF
skinparam sequenceGroupBorderColor #AFA9EC
skinparam noteBorderColor #EF9F27
skinparam noteBackgroundColor #FAEEDA

title DS3 — Fecho de Dia e Sincronização Delta Sync (RF16, ADR-04, ADR-05, ADR-08)

actor "Gestor" as G
participant "FechoDiaController" as FC <<Apresentação>>
participant "AutorizacaoServico" as AZ <<Serviço>>
participant "FechoDiaServico" as FDS <<Serviço>>
participant "VendaRepositorio" as VR <<Repositório>>
participant "DevolucaoRepositorio" as DR <<Repositório>>
participant "RemessaRepositorio" as RR <<Repositório>>
participant "PagamentoRepositorio" as PR <<Repositório>>
participant "LogAuditoriaRepositorio" as LAR <<Repositório>>
participant "FechoDiaRepositorio" as FDR <<Repositório>>
participant "ServidorCentral\n(HTTP)" as SC <<Externo>>

== Autorização (RF2) ==

G -> FC : onIniciarFecho()
activate FC

FC -> AZ : exigirPerfil(utilizador, GESTOR, CEO)
activate AZ
AZ --> FC : ok
deactivate AZ

== Reversão de registos em trânsito (ADR-04) ==

FC -> FDS : executarFecho(utilizador, configuracaoTerminal)
activate FDS

note over FDS
  Em caso de reinício anterior com envio
  incompleto, registos EM_TRANSITO são
  revertidos para PENDENTE antes de
  compilar o novo pacote (ADR-04).
end note

FDS -> VR : reverterEmTransito()
activate VR
VR --> FDS : ok
deactivate VR

FDS -> DR : reverterEmTransito()
activate DR
DR --> FDS : ok
deactivate DR

FDS -> RR : reverterEmTransito()
activate RR
RR --> FDS : ok
deactivate RR

FDS -> PR : reverterEmTransito()
activate PR
PR --> FDS : ok
deactivate PR

FDS -> LAR : reverterEmTransito()
activate LAR
LAR --> FDS : ok
deactivate LAR

== Compilação do pacote (RF16) ==

note over FDS, LAR
  O pacote agrega TODOS os registos com
  estadoSincronizacao = PENDENTE de todas
  as entidades que estendem RegistoSincronizavel.
  O idLoja é lido de ConfiguracaoTerminal
  para identificar a origem (ADR-05).
end note

FDS -> VR : buscarPendentes()
activate VR
VR --> FDS : vendas : List<Venda>
deactivate VR

FDS -> DR : buscarPendentes()
activate DR
DR --> FDS : devolucoes : List<Devolucao>
deactivate DR

FDS -> RR : buscarPendentes()
activate RR
RR --> FDS : remessas : List<Remessa>
deactivate RR

FDS -> PR : buscarPendentes()
activate PR
PR --> FDS : pagamentos : List<Pagamento>
deactivate PR

FDS -> LAR : buscarPendentes()
activate LAR
LAR --> FDS : logs : List<LogAuditoria>
deactivate LAR

FDS -> FDS : serializarParaDTO(idLoja, dataFecho, vendas,\ndevolucoes, remessas, pagamentos, logs)

== Marcação EM_TRANSITO e envio HTTP (ADR-04, ADR-08) ==

FDS -> VR : marcarEmTransito(ids)
activate VR
VR --> FDS : ok
deactivate VR

FDS -> DR : marcarEmTransito(ids)
activate DR
DR --> FDS : ok
deactivate DR

FDS -> RR : marcarEmTransito(ids)
activate RR
RR --> FDS : ok
deactivate RR

FDS -> PR : marcarEmTransito(ids)
activate PR
PR --> FDS : ok
deactivate PR

FDS -> LAR : marcarEmTransito(ids)
activate LAR
LAR --> FDS : ok
deactivate LAR

FDS -> SC : POST /fecho (PacoteFechoDTO — JSON)
activate SC

== Fluxo de excepção — falha de comunicação ==

alt falha de rede ou timeout (ADR-08)
  SC --> FDS : <<erro HTTP / timeout>>

  note over FDS
    Registos EM_TRANSITO são revertidos
    para PENDENTE. FechoDia persiste com
    estado PENDENTE para reenvio posterior.
    A sessão NÃO é encerrada (RF16).
  end note

  FDS -> VR : reverterEmTransito()
  activate VR
  VR --> FDS : ok
  deactivate VR

  FDS -> DR : reverterEmTransito()
  activate DR
  DR --> FDS : ok
  deactivate DR

  FDS -> RR : reverterEmTransito()
  activate RR
  RR --> FDS : ok
  deactivate RR

  FDS -> PR : reverterEmTransito()
  activate PR
  PR --> FDS : ok
  deactivate PR

  FDS -> LAR : reverterEmTransito()
  activate LAR
  LAR --> FDS : ok
  deactivate LAR

  FDS -> FDR : guardar(fechoDia — estado PENDENTE)
  activate FDR
  FDR --> FDS : ok
  deactivate FDR

  FDS --> FC : <<lança>> EnvioFechoFalhouException
  FC --> G : alerta — "Falha no envio. Reenviar\nquando a ligação for restaurada."

else servidor respondeu 200 OK + ACK

  SC --> FDS : 200 OK (ACK — dataFecho, idLoja)
  deactivate SC

  == Marcação CONFIRMADO (ADR-04) ==

  note over FDS
    CONFIRMADO é marcado exclusivamente
    após recepção do ACK do servidor central.
    Nunca antes (ADR-04).
  end note

  FDS -> VR : marcarConfirmados(ids)
  activate VR
  VR --> FDS : ok
  deactivate VR

  FDS -> DR : marcarConfirmados(ids)
  activate DR
  DR --> FDS : ok
  deactivate DR

  FDS -> RR : marcarConfirmados(ids)
  activate RR
  RR --> FDS : ok
  deactivate RR

  FDS -> PR : marcarConfirmados(ids)
  activate PR
  PR --> FDS : ok
  deactivate PR

  FDS -> LAR : marcarConfirmados(ids)
  activate LAR
  LAR --> FDS : ok
  deactivate LAR

  FDS -> FDR : guardar(fechoDia — estado CONFIRMADO)
  activate FDR
  FDR --> FDS : ok
  deactivate FDR

  FDS --> FC : fechoDia : FechoDia
  deactivate FDS

  FC --> G : ecrã de login\n(sessão encerrada)
  deactivate FC

end

@enduml
