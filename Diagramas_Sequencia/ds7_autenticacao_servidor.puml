@startuml DS7_Autenticacao_Servidor
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceParticipantBorderColor #0F6E56
skinparam sequenceParticipantBackgroundColor #E1F5EE
skinparam sequenceActorBorderColor #0F6E56
skinparam sequenceActorBackgroundColor #E1F5EE
skinparam sequenceLifeLineBorderColor #5DCAA5
skinparam sequenceGroupBackgroundColor #F4FBF8
skinparam sequenceGroupBorderColor #5DCAA5
skinparam noteBorderColor #EF9F27
skinparam noteBackgroundColor #FAEEDA

title DS7 — Autenticação do CEO no Servidor Central (RF2)

actor "CEO" as C
participant "AutenticacaoCentralHandler\n(Javalin)" as AH <<Apresentação>>
participant "IAutenticacaoCentralServico" as AS <<Serviço>>
participant "CEORepositorio" as CR <<Repositório>>

== Submissão de credenciais ==

C -> AH : POST /login\n(nomeUtilizador, palavraPasse)
activate AH

AH -> AS : autenticar(nomeUtilizador, palavraPasse)
activate AS

AS -> CR : buscarPorCredenciais(nomeUtilizador, hashPalavraPasse)
activate CR

alt credenciais inválidas (utilizador não encontrado)
  CR --> AS : null
  deactivate CR

  == Verificação de bloqueio antes de registar tentativa ==

  AS -> CR : buscarPorNomeUtilizador(nomeUtilizador)
  activate CR
  CR --> AS : ceo : CEO
  deactivate CR

  alt conta não existe
    AS --> AH : <<lança>> CredenciaisInvalidasException
    AH --> C : 401 Unauthorized\n("Credenciais inválidas")
  else conta existe

    AS -> AS : desbloquearSeExpirado(ceo)

    note over AS
      Se bloqueadoAte < agora,
      o bloqueio expirou — reset
      de tentativasLogin para 0.
    end note

    alt conta bloqueada (bloqueadoAte >= agora)
      AS --> AH : <<lança>> ContaBloqueadaException
      AH --> C : 403 Forbidden\n("Conta bloqueada até HH:MM")
    else conta não bloqueada

      note over AS
        Incrementa tentativasLogin.
        Se atingir 5 tentativas,
        define bloqueadoAte = agora + 15 min.
      end note

      AS -> AS : ceo.registarTentativaFalhada()

      AS -> CR : atualizar(ceo)
      activate CR
      CR --> AS : ok
      deactivate CR

      alt tentativasLogin >= 5
        AS --> AH : <<lança>> ContaBloqueadaException
        AH --> C : 403 Forbidden\n("Conta bloqueada por 15 minutos\napós 5 tentativas falhadas")
      else tentativasLogin < 5
        AS --> AH : <<lança>> CredenciaisInvalidasException
        AH --> C : 401 Unauthorized\n("Credenciais inválidas.\nTentativas restantes: N")
      end

    end
  end

else credenciais válidas
  CR --> AS : ceo : CEO
  deactivate CR

  == Verificação de bloqueio activo ==

  alt conta bloqueada (bloqueadoAte >= agora)
    AS --> AH : <<lança>> ContaBloqueadaException
    AH --> C : 403 Forbidden\n("Conta bloqueada até HH:MM")
  else conta não bloqueada

    note over AS
      Credenciais válidas e conta desbloqueada.
      Reset de tentativasLogin para 0
      e criação da sessão HTTP.
    end note

    AS -> AS : ceo.desbloquear()

    AS -> CR : atualizar(ceo)
    activate CR
    CR --> AS : ok
    deactivate CR

    AS --> AH : ceo : CEO
    deactivate AS

    AH --> C : 200 OK\n(sessão iniciada, redireciona\npara dashboard)
  end

end

deactivate AH

== Encerramento de sessão ==

C -> AH : POST /logout
activate AH

note over AH
  Invalida a sessão HTTP.
  Sem alterações na base de dados
  — o CEO não tem campo emSessao
  (perfil único, sem sessões duplicadas).
end note

AH --> C : 200 OK\n(redireciona para login)
deactivate AH

@enduml
