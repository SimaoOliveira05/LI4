<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.trasmum.loja.apresentacao.controllers.VendaController"
      spacing="12" styleClass="view-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Registo de Venda" styleClass="view-title"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="btnIniciar" text="Iniciar Venda" onAction="#onIniciarVenda" styleClass="btn-primary"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Código de barras:"/>
        <TextField fx:id="txtCodigoBarras" promptText="Scan / digitar" prefWidth="220"/>
        <Label text="Qtd.:"/>
        <TextField fx:id="txtQuantidade" text="1" prefWidth="60"/>
        <Button fx:id="btnAdicionar" text="Adicionar" onAction="#onAdicionarLinha" styleClass="btn-secondary"/>
    </HBox>

    <TableView fx:id="tblLinhas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colLote"    text="Lote"      prefWidth="80"/>
            <TableColumn fx:id="colQtd"     text="Qtd."      prefWidth="70"/>
            <TableColumn fx:id="colPreco"   text="Preço (€)" prefWidth="100"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal (€)" prefWidth="110"/>
        </columns>
    </TableView>

    <HBox spacing="16" alignment="CENTER_RIGHT">
        <Label fx:id="lblTotal" text="Total: 0.00 €" styleClass="total-label"/>
    </HBox>

    <GridPane hgap="8" vgap="8">
        <Label text="Método de pagamento:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <HBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <RadioButton fx:id="rbNumerario"  text="Numerário"/>
            <RadioButton fx:id="rbMultibanco" text="Multibanco"/>
        </HBox>
        <Label text="Valor entregue (€):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtValorEntregue" prefWidth="120" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label fx:id="lblTroco" styleClass="troco-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="NIF cliente (opcional):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtNif" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="8">
        <Button fx:id="btnFinalizar" text="Finalizar Venda" onAction="#onFinalizarVenda" styleClass="btn-primary"/>
        <Button fx:id="btnAnular"    text="Anular Venda"    onAction="#onAnularVenda"    styleClass="btn-danger"/>
    </HBox>
</VBox>
