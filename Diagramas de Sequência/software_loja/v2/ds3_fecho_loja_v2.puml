@startuml DS3_Fecho_Loja
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceParticipantBorderColor #534AB7
skinparam sequenceParticipantBackgroundColor #EEEDFE
skinparam sequenceActorBorderColor #534AB7
skinparam sequenceActorBackgroundColor #EEEDFE
skinparam sequenceLifeLineBorderColor #AFA9EC
skinparam sequenceGroupBackgroundColor #F8F8FF
skinparam sequenceGroupBorderColor #AFA9EC
skinparam noteBorderColor #EF9F27
skinparam noteBackgroundColor #FAEEDA

title DS3 — Fecho de Dia e Sincronização Delta Sync (RF16, ADR-04, ADR-05, ADR-08)

actor "Gestor" as G
participant "FechoDiaController" as FC <<Apresentação>>
participant "IAutorizacaoServico" as AZ <<Serviço>>
participant "IFechoDiaServico" as FDS <<Serviço>>
participant "IVendaServico" as IVS <<Serviço>>
participant "IDevolucaoServico" as IDS <<Serviço>>
participant "ICaixaServico" as ICS <<Serviço>>
participant "IRemessaServico" as IRS <<Serviço>>
participant "IAuditoriaServico" as IAS <<Serviço>>
participant "FechoDiaRepositorio" as FDR <<Repositório>>
participant "SincronizacaoGateway" as SG <<Rede>>

== Autorização (RF2) ==

G -> FC : onIniciarFecho()
activate FC

FC -> AZ : exigirPerfil(utilizador, GESTOR, CEO)
activate AZ
AZ --> FC : ok
deactivate AZ

== Reversão de registos em trânsito (ADR-04) ==

FC -> FDS : executarFecho(utilizador, configuracaoTerminal)
activate FDS

note over FDS
  Antes de compilar o pacote, o FechoDiaServico
  invoca reverterEmTransito() em cada serviço
  para repor a PENDENTE quaisquer registos que
  ficaram EM_TRANSITO num envio anterior falhado
  (ADR-04).
end note

FDS -> IVS : obterVendasPendentes()
activate IVS
note right of IVS
  Cada serviço reverterá internamente
  os seus registos EM_TRANSITO para
  PENDENTE antes de devolver a lista.
end note
IVS --> FDS : vendas : List<Venda>
deactivate IVS

FDS -> IDS : obterDevolucoesPendentes()
activate IDS
IDS --> FDS : devolucoes : List<Devolucao>
deactivate IDS

FDS -> ICS : obterSessoesPendentes()
activate ICS
ICS --> FDS : sessoesCaixa : List<SessaoCaixa>
deactivate ICS

FDS -> IRS : obterRemessasPendentes()
activate IRS
IRS --> FDS : remessas : List<Remessa>
deactivate IRS

FDS -> IRS : obterPagamentosPendentes()
activate IRS
IRS --> FDS : pagamentos : List<Pagamento>
deactivate IRS

FDS -> IAS : obterLogsPendentes()
activate IAS
IAS --> FDS : logs : List<LogAuditoria>
deactivate IAS

== Compilação e marcação EM_TRANSITO (ADR-04, ADR-05) ==

note over FDS
  compilarDadosPendentes() agrega todos os registos
  e serializa o PacoteFechoDTO com o idLoja lido de
  ConfiguracaoTerminal para identificar a origem (ADR-05).
  marcarRegistosComo(EM_TRANSITO) é então invocado
  internamente sobre todos os registos agregados.
end note

FDS -> FDS : compilarDadosPendentes()
FDS -> FDS : marcarRegistosComo(EM_TRANSITO)

== Envio HTTP ao Servidor Central (ADR-08) ==

FDS -> SG : enviarFechoDia(pacoteFechoDTO)
activate SG

alt falha de rede ou timeout (ADR-08)
  SG --> FDS : false

  note over FDS
    Registos EM_TRANSITO são revertidos
    para PENDENTE. FechoDia persiste com
    estado PENDENTE para reenvio posterior.
    A sessão NÃO é encerrada (RF16).
  end note

  FDS -> FDS : marcarRegistosComo(PENDENTE)

  FDS -> FDR : guardar(fechoDia — estado PENDENTE)
  activate FDR
  FDR --> FDS : ok
  deactivate FDR

  FDS --> FC : <<lança>> EnvioFechoFalhouException
  FC --> G : alerta — "Falha no envio. Reenviar\nquando a ligação for restaurada."

else servidor respondeu 200 OK + ACK

  SG --> FDS : true
  deactivate SG

  == Marcação CONFIRMADO (ADR-04) ==

  note over FDS
    CONFIRMADO é marcado exclusivamente
    após recepção do ACK do servidor central.
    Nunca antes (ADR-04).
  end note

  FDS -> FDS : marcarRegistosComo(CONFIRMADO)

  FDS -> FDR : guardar(fechoDia — estado CONFIRMADO)
  activate FDR
  FDR --> FDS : ok
  deactivate FDR

  FDS --> FC : fechoDia : FechoDia
  deactivate FDS

  FC --> G : ecrã de login\n(sessão encerrada)
  deactivate FC

end

@enduml
