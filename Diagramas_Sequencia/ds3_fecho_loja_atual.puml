@startuml DS3_Fecho_Loja_Atual
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceParticipantBorderColor #534AB7
skinparam sequenceParticipantBackgroundColor #EEEDFE
skinparam sequenceActorBorderColor #534AB7
skinparam sequenceActorBackgroundColor #EEEDFE
skinparam sequenceLifeLineBorderColor #AFA9EC
skinparam sequenceGroupBackgroundColor #F8F8FF
skinparam sequenceGroupBorderColor #AFA9EC
skinparam noteBorderColor #EF9F27
skinparam noteBackgroundColor #FAEEDA

title DS3 — Fecho de Dia e Sincronização (Implementação Actual)\nLoja → Servidor Central, com denormalização do PacoteFechoDTO

actor "Gestor" as G
participant "FechoDiaController" as FC <<Apresentação>>
participant "IAutorizacaoServico" as AZ <<Serviço>>
participant "IFechoDiaServico" as FDS <<Serviço>>
participant "Outros Serviços\n(IVendaServico, IDevolucaoServico,\nICaixaServico, IRemessaServico,\nIAuditoriaServico)" as OS <<Serviço>>
participant "Repos. denormalização\n(Produto, Lote, Fornecedor,\nUtilizador)" as DEN <<Repositório>>
participant "Repos. sincronizáveis\n(Venda, Devolucao, Remessa,\nPagamento, SessaoCaixa, Log)" as REP <<Repositório>>
participant "FechoDiaRepositorio" as FDR <<Repositório>>
participant "SincronizacaoGateway" as SG <<Rede>>

== Autorização ==
G -> FC : onIniciarFecho()
activate FC
FC -> AZ : exigirPerfil(utilizador, GESTOR, CEO)
AZ --> FC : ok

== Reversão de registos EM_TRANSITO ==
FC -> FDS : executarFecho(utilizador, configuracaoTerminal)
activate FDS

note over FDS
  reverterEmTransito() é chamado em cada
  repositório sincronizável antes de
  recolher pendentes (ADR-04).
end note

FDS -> OS : obterPendentes()\n(vendas, devoluções, sessões,\nremessas, pagamentos, logs)
OS --> FDS : registos pendentes

== Compilação do PacoteFechoDTO (denormalizado) ==

note over FDS, DEN
  O PacoteFechoDTO esperado pelo Servidor Central
  é denormalizado: nomeFornecedor (em vez de
  idFornecedor), nomeProduto e categoria nas
  linhas, nomeUtilizador nos logs, idOriginalVenda
  nas devoluções, idOriginalRemessa nos pagamentos.
  O FechoDiaServico resolve estes campos a partir
  dos repositórios de Produto/Lote/Fornecedor/Utilizador.
end note

FDS -> DEN : resolver nomes/categorias\n(produto, fornecedor, utilizador)
DEN --> FDS : dados denormalizados

FDS -> FDS : compilarPacote() : PacoteFechoDTO
note right of FDS
  Inclui idLoja, nomeLoja,
  dataFecho e hashIntegridade
  (SHA-256) sobre o conteúdo.
end note

FDS -> REP : marcarRegistosComo(EM_TRANSITO)

== Envio HTTP (HTTPS) ao Servidor Central ==
FDS -> SG : enviarFechoDia(pacoteFechoDTO)
activate SG

alt falha de rede / timeout / 5xx
  SG --> FDS : false
  deactivate SG
  FDS -> REP : marcarRegistosComo(PENDENTE)
  FDS -> FDR : guardar(fechoDia — PENDENTE)
  FDS --> FC : <<lança>> EnvioFechoFalhouException
  FC --> G : alerta — "Falha no envio.\nReenviar mais tarde."
else 200 OK + ACK
  SG --> FDS : true
  FDS -> REP : marcarRegistosComo(CONFIRMADO)
  FDS -> FDR : guardar(fechoDia — CONFIRMADO)
  FDS --> FC : fechoDia : FechoDia
  deactivate FDS
  FC --> G : ecrã de login (sessão encerrada)
  deactivate FC
end

@enduml
