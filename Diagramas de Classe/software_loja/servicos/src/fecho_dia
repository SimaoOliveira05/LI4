package "Serviço (Fecho e Sincronização)" #EEF9F4 {

  class FechoDiaServico {
    - vendaServico : VendaServico
    - remessaServico : RemessaServico
    - caixaServico : CaixaServico
    - pagamentoServico : PagamentoServico
    - auditoriaServico : AuditoriaServico
    - autorizacaoServico : AutorizacaoServico
    - fechoDiaRepositorio : FechoDiaRepositorio
    + executarFecho(utilizador : Utilizador, configuracao : ConfiguracaoTerminal) : FechoDia
    + reenviar(idFecho : int) : boolean
    + reverterEmTransito() : void
  }
}

' Relações (Orquestração Lateral)
FechoDiaServico ..> VendaServico : " consolida vendas"
FechoDiaServico ..> RemessaServico : " consolida remessas"
FechoDiaServico ..> CaixaServico : " consolida caixas"
FechoDiaServico ..> PagamentoServico : " consolida pagamentos"

' Relações com Core/Dados
FechoDiaServico ..> AuditoriaServico
FechoDiaServico ..> AutorizacaoServico
FechoDiaServico ..> FechoDiaRepositorio : " persiste fecho"

@enduml
