# BASE DE DADOS (usado pelo backend dentro do Docker)
DB_URL=jdbc:mysql://mysql:3306/trasmum_servidor?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USER=trasmum
DB_PASSWORD=trasmum

# CORS — origem permitida pelo backend
FRONTEND_ORIGEM=http://localhost:3000

# Porta do backend (dentro do container)
SERVER_PORT=8080

# URL do backend visível ao browser (usada pelo Vite no build do frontend)
VITE_API_URL=http://localhost:8080

# Retry de ligação à BD ao arrancar
DB_RETRY_MAX_TENTATIVAS=15
DB_RETRY_DELAY_MS=3000
