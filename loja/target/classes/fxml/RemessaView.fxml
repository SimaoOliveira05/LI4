<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.trasmum.loja.apresentacao.controllers.RemessaController"
      spacing="12" styleClass="view-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Remessas e Pedidos" styleClass="view-title"/>

    <TabPane>
        <!-- Aba Registar Remessa -->
        <Tab text="Registar Remessa" closable="false">
            <VBox spacing="10">
                <padding><Insets top="12" right="8" bottom="8" left="8"/></padding>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Fornecedor:"/>
                    <ComboBox fx:id="cmbFornecedorRemessa" prefWidth="200"/>
                    <Label text="Valor guia (€):"/>
                    <TextField fx:id="txtValorGuia" prefWidth="100"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="ID Produto:"/>
                    <TextField fx:id="txtProdutoId" prefWidth="90"/>
                    <Label text="Qtd.:"/>
                    <TextField fx:id="txtQtdRemessa" prefWidth="70"/>
                    <Label text="Validade:"/>
                    <DatePicker fx:id="dpValidade"/>
                    <Button text="Adicionar linha" onAction="#onAdicionarLinhaRemessa" styleClass="btn-secondary"/>
                </HBox>
                <TableView fx:id="tblLinhasRemessa" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colProdutoR"  text="Produto" prefWidth="100"/>
                        <TableColumn fx:id="colQtdR"      text="Qtd."    prefWidth="80"/>
                        <TableColumn fx:id="colValidadeR" text="Validade" prefWidth="120"/>
                    </columns>
                </TableView>
                <Button text="Registar Remessa" onAction="#onRegistarRemessa" styleClass="btn-primary"/>
            </VBox>
        </Tab>

        <!-- Aba Pedidos de Remessa -->
        <Tab text="Pedidos de Remessa" closable="false">
            <VBox spacing="10">
                <padding><Insets top="12" right="8" bottom="8" left="8"/></padding>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Filtrar:"/>
                    <ComboBox fx:id="cmbFiltroPedido" prefWidth="150" onAction="#onFiltrarPedidos"/>
                    <Button text="Novo Pedido" onAction="#onNovoPedido" styleClass="btn-primary"/>
                </HBox>
                <TableView fx:id="tblPedidos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdPedido"        text="ID"         prefWidth="60"/>
                        <TableColumn fx:id="colFornecedorPedido" text="Fornecedor" prefWidth="160"/>
                        <TableColumn fx:id="colEstadoPedido"    text="Estado"     prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
