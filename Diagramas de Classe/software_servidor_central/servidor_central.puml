@startuml Software_do_Servidor_Central_v2
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #E1F5EE
skinparam classBorderColor #0F6E56
skinparam classBackgroundColor #FAFAFA
skinparam arrowColor #0F6E56
skinparam stereotypeCBackgroundColor #EEEDFE
skinparam stereotypeABackgroundColor #FAC775
skinparam stereotypeIBackgroundColor #D1ECF1
skinparam packageBackgroundColor #F8F8F8
skinparam packageBorderColor #B4B2A9
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50

title Software do Servidor Central — Diagrama de Classes (Layered Architecture + REST via Javalin)

' ╔══════════════════════════════════════╗
' ║    CAMADA DE APRESENTAÇÃO            ║
' ║    (Handlers HTTP Javalin + UI CEO)  ║
' ╚══════════════════════════════════════╝
package "Apresentação (Handlers Javalin + UI CEO)" #EEF4FF {

  class AutenticacaoCentralHandler {
    - autenticacaoServico : AutenticacaoCentralServico
    + post_login(ctx : Context) : void
    + post_logout(ctx : Context) : void
  }

  class RecepcaoPacoteHandler {
    - recepcaoPacoteServico : RecepcaoPacoteServico
    + post_pacoteFecho(ctx : Context) : void
  }
  note right of RecepcaoPacoteHandler
    Endpoint HTTP POST via Javalin
    (ADR-08). Recebe PacoteFechoDTO
    serializado em JSON das lojas.
  end note

  class DashboardHandler {
    - dashboardServico : DashboardServico
    + get_metricasGlobais(ctx : Context) : void
    + get_metricasPorLoja(ctx : Context) : void
    + get_alertasStock(ctx : Context) : void
  }

  class RelatorioHandler {
    - relatorioServico : RelatorioServico
    + get_relatorio(ctx : Context) : void
  }

  class RemessaRedeHandler {
    - remessaRedeServico : RemessaRedeServico
    + get_remessas(ctx : Context) : void
  }

  class ConsolidacaoHandler {
    - consolidacaoServico : ConsolidacaoServico
    + get_estadoConsolidacao(ctx : Context) : void
  }
}

' ╔══════════════════════════════════════╗
' ║          CAMADA DE SERVIÇO           ║
' ╚══════════════════════════════════════╝
package "Serviço (Lógica de Negócio Central)" #EEF9F4 {

  class AutenticacaoCentralServico {
    - ceoRepositorio : CEORepositorio
    + autenticar(nomeUtilizador : String, palavraPasse : String) : CEO
    + registarTentativaFalhada(nomeUtilizador : String) : void
    + desbloquear(nomeUtilizador : String) : void
    + estaBloqueada(nomeUtilizador : String) : boolean
  }

  class RecepcaoPacoteServico {
    - lojaRepositorio : LojaRepositorio
    - vendaRepositorio : VendaCentralRepositorio
    - devolucaoRepositorio : DevolucaoCentralRepositorio
    - remessaRepositorio : RemessaCentralRepositorio
    - pagamentoRepositorio : PagamentoCentralRepositorio
    - logRepositorio : LogAuditoriaCentralRepositorio
    - fechoDiaCentralRepositorio : FechoDiaCentralRepositorio
    + receberPacote(dto : PacoteFechoDTO) : void
    + validarIntegridade(dto : PacoteFechoDTO) : boolean
    + persistirEntidades(dto : PacoteFechoDTO, loja : Loja) : void
    + enviarConfirmacao(idLoja : String, dataFecho : LocalDate) : void
  }
  note right of RecepcaoPacoteServico
    Deduplicação por INSERT IGNORE
    usando chave loja + idOriginalLoja
    (ADR-05). Cria Loja automaticamente
    se ainda não existir.
  end note

  class DashboardServico {
    - vendaRepositorio : VendaCentralRepositorio
    - remessaRepositorio : RemessaCentralRepositorio
    - lojaRepositorio : LojaRepositorio
    + obterMetricasGlobais(data : LocalDate) : MetricasGlobais
    + obterMetricasPorLoja(idLoja : String, data : LocalDate) : MetricasLoja
    + obterAlertasStock() : List~AlertaStock~
  }

  class RelatorioServico {
    - vendaRepositorio : VendaCentralRepositorio
    - devolucaoRepositorio : DevolucaoCentralRepositorio
    - remessaRepositorio : RemessaCentralRepositorio
    + gerar(filtro : FiltroRelatorio) : Relatorio
  }

  class RemessaRedeServico {
    - remessaRepositorio : RemessaCentralRepositorio
    + listar(filtro : FiltroRemessa) : List~RemessaCentral~
  }

  class ConsolidacaoServico {
    - fechoDiaCentralRepositorio : FechoDiaCentralRepositorio
    - lojaRepositorio : LojaRepositorio
    + verificarCompletude(data : LocalDate) : EstadoFecho
    + obterLojasFaltantes(data : LocalDate) : List~Loja~
  }
}

' ╔══════════════════════════════════════╗
' ║         CAMADA DE REPOSITÓRIO        ║
' ╚══════════════════════════════════════╝
package "Repositório (Acesso a Dados Central)" #FFF8EE {

  interface CEORepositorio {
    + buscarPorCredenciais(nomeUtilizador : String, hashPalavraPasse : String) : CEO
    + atualizar(ceo : CEO) : void
  }

  class CEORepositorioImpl {
    - conexao : Connection
    + buscarPorCredenciais(nomeUtilizador : String, hashPalavraPasse : String) : CEO
    + atualizar(ceo : CEO) : void
  }

  interface LojaRepositorio {
    + buscarPorId(idLoja : String) : Loja
    + guardarSeNaoExistir(loja : Loja) : Loja
    + listarTodas() : List~Loja~
  }

  class LojaRepositorioImpl {
    - conexao : Connection
    + buscarPorId(idLoja : String) : Loja
    + guardarSeNaoExistir(loja : Loja) : Loja
    + listarTodas() : List~Loja~
  }

  interface VendaCentralRepositorio {
    + guardarSeNaoExistir(venda : VendaCentral) : void
    + buscarPorLojaEPeriodo(idLoja : String, inicio : LocalDate, fim : LocalDate) : List~VendaCentral~
    + totalVendasPorLoja(data : LocalDate) : Map~String, Double~
  }

  class VendaCentralRepositorioImpl {
    - conexao : Connection
    + guardarSeNaoExistir(venda : VendaCentral) : void
    + buscarPorLojaEPeriodo(idLoja : String, inicio : LocalDate, fim : LocalDate) : List~VendaCentral~
    + totalVendasPorLoja(data : LocalDate) : Map~String, Double~
  }

  interface DevolucaoCentralRepositorio {
    + guardarSeNaoExistir(devolucao : DevolucaoCentral) : void
    + buscarPorLojaEPeriodo(idLoja : String, inicio : LocalDate, fim : LocalDate) : List~DevolucaoCentral~
  }

  class DevolucaoCentralRepositorioImpl {
    - conexao : Connection
    + guardarSeNaoExistir(devolucao : DevolucaoCentral) : void
    + buscarPorLojaEPeriodo(idLoja : String, inicio : LocalDate, fim : LocalDate) : List~DevolucaoCentral~
  }

  interface RemessaCentralRepositorio {
    + guardarSeNaoExistir(remessa : RemessaCentral) : void
    + buscarPorFiltro(filtro : FiltroRemessa) : List~RemessaCentral~
  }

  class RemessaCentralRepositorioImpl {
    - conexao : Connection
    + guardarSeNaoExistir(remessa : RemessaCentral) : void
    + buscarPorFiltro(filtro : FiltroRemessa) : List~RemessaCentral~
  }

  interface PagamentoCentralRepositorio {
    + guardarSeNaoExistir(pagamento : PagamentoCentral) : void
  }

  class PagamentoCentralRepositorioImpl {
    - conexao : Connection
    + guardarSeNaoExistir(pagamento : PagamentoCentral) : void
  }

  interface LogAuditoriaCentralRepositorio {
    + guardarSeNaoExistir(log : LogAuditoriaCentral) : void
    + buscarPorLojaEPeriodo(idLoja : String, inicio : LocalDate, fim : LocalDate) : List~LogAuditoriaCentral~
  }

  class LogAuditoriaCentralRepositorioImpl {
    - conexao : Connection
    + guardarSeNaoExistir(log : LogAuditoriaCentral) : void
    + buscarPorLojaEPeriodo(idLoja : String, inicio : LocalDate, fim : LocalDate) : List~LogAuditoriaCentral~
  }

  interface FechoDiaCentralRepositorio {
    + guardar(fecho : FechoDiaCentral) : void
    + buscarPorData(data : LocalDate) : List~FechoDiaCentral~
    + buscarLojasFaltantes(data : LocalDate) : List~Loja~
  }

  class FechoDiaCentralRepositorioImpl {
    - conexao : Connection
    + guardar(fecho : FechoDiaCentral) : void
    + buscarPorData(data : LocalDate) : List~FechoDiaCentral~
    + buscarLojasFaltantes(data : LocalDate) : List~Loja~
  }
}

' ╔══════════════════════════════════════╗
' ║           CAMADA DE DOMÍNIO          ║
' ╚══════════════════════════════════════╝
package "Domínio (Entidades Centrais, Enumerações e DTOs)" #FEFEFE {

  class CEO {
    - id : int
    - nomeUtilizador : String
    - hashPalavraPasse : String
    - tentativasLogin : int
    - bloqueadaAte : LocalDateTime
    + getId() : int
    + getNomeUtilizador() : String
    + getTentativasLogin() : int
    + getBloqueadaAte() : LocalDateTime
    + estaBloqueada() : boolean
  }
  note bottom of CEO
    Único perfil com acesso ao servidor
    central. Bloqueio após 5 tentativas
    falhadas (RF2).
  end note

  class Loja {
    - idLoja : String
    - nomeLoja : String
    + getIdLoja() : String
    + getNomeLoja() : String
  }
  note bottom of Loja
    Criada automaticamente ao receber
    o primeiro pacote de fecho de dia
    de uma loja desconhecida.
    Permite filtrar dados por loja
    nos dashboards (RF20, RF21).
  end note

  class VendaCentral {
    - id : int
    - idOriginalLoja : int
    - idLoja : String
    - dataHora : LocalDateTime
    - totalFaturado : double
    - metodoPagamento : MetodoPagamentoCentral
    + getIdOriginalLoja() : int
    + getIdLoja() : String
    + getTotalFaturado() : double
  }
  note bottom of VendaCentral
    Chave idempotência: idLoja +
    idOriginalLoja (ADR-05).
    Versão de leitura — sem
    mecanismo de sincronização.
  end note

  class LinhaVendaCentral {
    - id : int
    - idVendaCentral : int
    - idOriginalLoja : int
    - idLoja : String
    - nomeProduto : String
    - categoria : String
    - quantidade : int
    - precoUnitario : double
    - subtotal : double
    + calcularSubtotal() : double
  }

  class DevolucaoCentral {
    - id : int
    - idOriginalLoja : int
    - idLoja : String
    - dataHora : LocalDateTime
    - quantidade : int
    - valorRestituido : double
    + getIdOriginalLoja() : int
    + getIdLoja() : String
  }

  class RemessaCentral {
    - id : int
    - idOriginalLoja : int
    - idLoja : String
    - nomeFornecedor : String
    - dataRecepcao : LocalDate
    - valorTotalGuia : double
    - estadoPagamento : EstadoPagamento
    + getIdOriginalLoja() : int
    + getEstadoPagamento() : EstadoPagamento
  }

  class PagamentoCentral {
    - id : int
    - idOriginalLoja : int
    - idLoja : String
    - valor : double
    - dataPagamento : LocalDate
    - tipoPagamento : TipoPagamentoCentral
    + getIdOriginalLoja() : int
    + getIdLoja() : String
  }

  class LogAuditoriaCentral {
    - id : int
    - idOriginalLoja : int
    - idLoja : String
    - acao : TipoAcaoCentral
    - dataHora : LocalDateTime
    - nomeUtilizador : String
    + getIdOriginalLoja() : int
    + getAcao() : TipoAcaoCentral
  }

  class FechoDiaCentral {
    - id : int
    - dataFecho : LocalDate
    - idLoja : String
    - estadoCompletude : EstadoFecho
    + getDataFecho() : LocalDate
    + getIdLoja() : String
    + getEstadoCompletude() : EstadoFecho
    + isCompleto() : boolean
  }
  note bottom of FechoDiaCentral
    Registo de cada fecho recebido.
    EstadoFecho.PARCIAL quando nem
    todas as lojas enviaram (RF15).
  end note

  class PedidoFecho {
    - id : int
    - dataPedido : LocalDate
    - janelaTemporalMinutos : int
    - estadoConsolidacao : EstadoConsolidacao
    + isConsolidado() : boolean
    + getJanelaTemporalMinutos() : int
  }
  note bottom of PedidoFecho
    Consolidação nocturna. Janela
    temporal configurável em minutos.
  end note

  ' --- Enumerações ---
  enum MetodoPagamentoCentral {
    NUMERARIO
    MULTIBANCO
  }

  enum EstadoPagamento {
    PENDENTE_PAGAMENTO
    PAGA
  }

  enum TipoPagamentoCentral {
    TRANSFERENCIA
    NUMERARIO
    CHEQUE
  }

  enum TipoAcaoCentral {
    VENDA
    DEVOLUCAO
    ALTERACAO_PRECO
    APLICACAO_DESCONTO
    GESTAO_UTILIZADOR
    ALTERACAO_CATALOGO
  }

  enum EstadoFecho {
    COMPLETO
    PARCIAL
  }

  enum EstadoConsolidacao {
    PENDENTE
    CONSOLIDADO
    ERRO
  }

  ' --- Análise ---
  class MetricasGlobais {
    - totalVendasRede : double
    - totalTransaccoes : int
    - totalDevolucoes : double
    - totalRemessasPendentes : double
    - dataReferencia : LocalDate
    + getTotalVendasRede() : double
    + getVendasPorLoja() : Map~String, Double~
  }

  class MetricasLoja {
    - idLoja : String
    - nomeLoja : String
    - totalVendas : double
    - numeroTransaccoes : int
    - totalDevolucoes : double
    - totalNumerario : double
    - totalMultibanco : double
    - dataReferencia : LocalDate
    + getTotalVendas() : double
  }

  class AlertaStock {
    - idLoja : String
    - nomeLoja : String
    - nomeProduto : String
    - quantidadeActual : int
    - tipoAlerta : TipoAlerta
    + getTipoAlerta() : TipoAlerta
  }

  enum TipoAlerta {
    RUTURA_IMINENTE
    EXCESSO_STOCK
  }

  class Relatorio {
    - titulo : String
    - dataGeracao : LocalDateTime
    - filtrosAplicados : FiltroRelatorio
    + exportar() : byte[]
    + getTitulo() : String
  }

  class FiltroRelatorio {
    - idLojas : List~String~
    - dataInicio : LocalDate
    - dataFim : LocalDate
    - categorias : List~String~
    + getIdLojas() : List~String~
  }

  class FiltroRemessa {
    - idLojas : List~String~
    - estadoPagamento : EstadoPagamento
    - dataInicio : LocalDate
    - dataFim : LocalDate
    + getEstadoPagamento() : EstadoPagamento
  }

  ' --- DTOs de transferência loja → servidor ---
  class PacoteFechoDTO {
    + idLoja : String
    + nomeLoja : String
    + dataFecho : LocalDate
    + vendas : List~VendaDTO~
    + devolucoes : List~DevolucaoDTO~
    + remessas : List~RemessaDTO~
    + pagamentos : List~PagamentoDTO~
    + logs : List~LogAuditoriaDTO~
  }
  note bottom of PacoteFechoDTO
    Objecto de transferência serializado
    em JSON entre Software de Loja e
    Servidor Central via HTTP (ADR-08).
    Deserializado pelo RecepcaoPacoteHandler.
  end note

  class VendaDTO {
    + idOriginalLoja : int
    + dataHora : LocalDateTime
    + totalFaturado : double
    + metodoPagamento : String
    + linhas : List~LinhaVendaDTO~
  }

  class LinhaVendaDTO {
    + idOriginalLoja : int
    + nomeProduto : String
    + categoria : String
    + quantidade : int
    + precoUnitario : double
  }

  class DevolucaoDTO {
    + idOriginalLoja : int
    + dataHora : LocalDateTime
    + quantidade : int
    + valorRestituido : double
  }

  class RemessaDTO {
    + idOriginalLoja : int
    + nomeFornecedor : String
    + dataRecepcao : LocalDate
    + valorTotalGuia : double
    + estadoPagamento : String
  }

  class PagamentoDTO {
    + idOriginalLoja : int
    + valor : double
    + dataPagamento : LocalDate
    + tipoPagamento : String
  }

  class LogAuditoriaDTO {
    + idOriginalLoja : int
    + acao : String
    + dataHora : LocalDateTime
    + nomeUtilizador : String
  }
}

' ╔══════════════════════════════════════╗
' ║       RELAÇÕES ENTRE CAMADAS         ║
' ╚══════════════════════════════════════╝

' Handlers → Serviços
AutenticacaoCentralHandler ..> AutenticacaoCentralServico
RecepcaoPacoteHandler ..> RecepcaoPacoteServico
DashboardHandler ..> DashboardServico
RelatorioHandler ..> RelatorioServico
RemessaRedeHandler ..> RemessaRedeServico
ConsolidacaoHandler ..> ConsolidacaoServico

' Handlers recebem/devolvem DTOs
RecepcaoPacoteHandler ..> PacoteFechoDTO

' Serviços → Repositórios
AutenticacaoCentralServico ..> CEORepositorio
RecepcaoPacoteServico ..> LojaRepositorio
RecepcaoPacoteServico ..> VendaCentralRepositorio
RecepcaoPacoteServico ..> DevolucaoCentralRepositorio
RecepcaoPacoteServico ..> RemessaCentralRepositorio
RecepcaoPacoteServico ..> PagamentoCentralRepositorio
RecepcaoPacoteServico ..> LogAuditoriaCentralRepositorio
RecepcaoPacoteServico ..> FechoDiaCentralRepositorio
DashboardServico ..> VendaCentralRepositorio
DashboardServico ..> RemessaCentralRepositorio
DashboardServico ..> LojaRepositorio
RelatorioServico ..> VendaCentralRepositorio
RelatorioServico ..> DevolucaoCentralRepositorio
RelatorioServico ..> RemessaCentralRepositorio
RemessaRedeServico ..> RemessaCentralRepositorio
ConsolidacaoServico ..> FechoDiaCentralRepositorio
ConsolidacaoServico ..> LojaRepositorio

' Implementações realizam interfaces
CEORepositorioImpl ..|> CEORepositorio
LojaRepositorioImpl ..|> LojaRepositorio
VendaCentralRepositorioImpl ..|> VendaCentralRepositorio
DevolucaoCentralRepositorioImpl ..|> DevolucaoCentralRepositorio
RemessaCentralRepositorioImpl ..|> RemessaCentralRepositorio
PagamentoCentralRepositorioImpl ..|> PagamentoCentralRepositorio
LogAuditoriaCentralRepositorioImpl ..|> LogAuditoriaCentralRepositorio
FechoDiaCentralRepositorioImpl ..|> FechoDiaCentralRepositorio

' Enumerações
VendaCentral --> MetodoPagamentoCentral
RemessaCentral --> EstadoPagamento
PagamentoCentral --> TipoPagamentoCentral
LogAuditoriaCentral --> TipoAcaoCentral
FechoDiaCentral --> EstadoFecho
PedidoFecho --> EstadoConsolidacao
AlertaStock --> TipoAlerta

' Entidades → Loja
VendaCentral --> Loja : idLoja
DevolucaoCentral --> Loja : idLoja
RemessaCentral --> Loja : idLoja
PagamentoCentral --> Loja : idLoja
LogAuditoriaCentral --> Loja : idLoja
FechoDiaCentral --> Loja : idLoja

' Composições
VendaCentral "1" *-- "1..*" LinhaVendaCentral : linhas
PedidoFecho "1" *-- "0..*" FechoDiaCentral : fechosRecebidos
Relatorio --> FiltroRelatorio : filtros

' DTOs internos
PacoteFechoDTO "1" *-- "0..*" VendaDTO
PacoteFechoDTO "1" *-- "0..*" DevolucaoDTO
PacoteFechoDTO "1" *-- "0..*" RemessaDTO
PacoteFechoDTO "1" *-- "0..*" PagamentoDTO
PacoteFechoDTO "1" *-- "0..*" LogAuditoriaDTO
VendaDTO "1" *-- "0..*" LinhaVendaDTO

' Serviços produzem VOs de análise
DashboardServico ..> MetricasGlobais : produz
DashboardServico ..> MetricasLoja : produz
DashboardServico ..> AlertaStock : produz
RelatorioServico ..> Relatorio : produz
RelatorioServico ..> FiltroRelatorio : consome
RemessaRedeServico ..> FiltroRemessa : consome

@enduml
