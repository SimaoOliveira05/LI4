<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.trasmum.loja.apresentacao.controllers.DevolucaoController"
      spacing="16" styleClass="view-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Devolução" styleClass="view-title"/>

    <GridPane hgap="12" vgap="10">
        <Label text="Nº Fatura:"            GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNumeroFatura"   GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="220"/>
        <Label text="Código de barras:"      GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtCodigoBarras"   GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="220"/>
        <Label text="Validade embalagem:"    GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <DatePicker fx:id="dpDataValidade"   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Quantidade:"            GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtQuantidade"     GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="80"/>
    </GridPane>

    <Button text="Processar Devolução" onAction="#onProcessarDevolucao" styleClass="btn-primary"/>
    <Label fx:id="lblResultado" wrapText="true" styleClass="resultado-label"/>
</VBox>
