<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.trasmum.loja.apresentacao.controllers.CatalogoController"
            styleClass="view-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <top>
        <VBox spacing="8">
            <Label text="Catálogo de Produtos" styleClass="view-title"/>
            <HBox spacing="8">
                <TextField fx:id="txtPesquisa" promptText="Pesquisar produto…"
                           prefWidth="300" onKeyReleased="#onPesquisar"/>
                <Button text="Criar"      onAction="#onCriarProduto"      styleClass="btn-primary"/>
                <Button text="Editar"     onAction="#onEditarProduto"     styleClass="btn-secondary"/>
                <Button text="Desativar"  onAction="#onDesativarProduto"  styleClass="btn-danger"/>
                <Button text="Desconto"  onAction="#onAplicarDesconto"   styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblProdutos">
            <columns>
                <TableColumn fx:id="colCodigo"   text="Código"    prefWidth="130"/>
                <TableColumn fx:id="colNome"     text="Nome"      prefWidth="200"/>
                <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="130"/>
                <TableColumn fx:id="colPreco"    text="Preço (€)" prefWidth="100"/>
                <TableColumn fx:id="colStock"    text="Stock"     prefWidth="90"/>
                <TableColumn fx:id="colAtivo"    text="Ativo"     prefWidth="70"/>
            </columns>
        </TableView>
    </center>

    <right>
        <VBox spacing="8" minWidth="240" styleClass="alertas-panel">
            <padding><Insets top="0" right="0" bottom="0" left="12"/></padding>

            <!-- Detalhes do produto selecionado — oculto por defeito -->
            <VBox fx:id="detalhesSection" spacing="4" managed="false" visible="false">
                <Label text="Detalhes do Produto" styleClass="section-title"/>
                <TableView fx:id="tblLotes" prefHeight="240">
                    <columns>
                        <TableColumn fx:id="colLoteId"       text="Lote"     prefWidth="45"/>
                        <TableColumn fx:id="colLoteQtd"      text="Qtd"      prefWidth="45"/>
                        <TableColumn fx:id="colLoteValidade" text="Validade"  prefWidth="88"/>
                        <TableColumn fx:id="colLotePreco"    text="Preço"    prefWidth="72"/>
                        <TableColumn fx:id="colLoteDesconto" text="Desconto" prefWidth="68"/>
                        <TableColumn fx:id="colLoteAbater"   text=""         prefWidth="62"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Alertas — ocupa todo o espaço disponível -->
            <VBox VBox.vgrow="ALWAYS" spacing="4">
                <Label text="Alertas" styleClass="section-title"/>
                <TextArea fx:id="txtAlertas" editable="false" wrapText="true"
                          VBox.vgrow="ALWAYS" styleClass="alertas-area"/>
            </VBox>
        </VBox>
    </right>
</BorderPane>
