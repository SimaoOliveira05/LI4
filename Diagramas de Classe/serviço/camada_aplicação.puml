@startuml Servico
skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam classHeaderBackgroundColor #EEEDFE
skinparam classBorderColor #534AB7
skinparam classBackgroundColor #FAFAFA
skinparam arrowColor #534AB7
skinparam stereotypeCBackgroundColor #E1F5EE
skinparam stereotypeABackgroundColor #FAC775
skinparam stereotypeIBackgroundColor #E1F5EE
skinparam packageBackgroundColor #F8F8F8
skinparam packageBorderColor #B4B2A9
skinparam linetype ortho

title Software de Loja — Diagrama de Classes (Serviços)

package "Serviço" {
  class VendaServico {
    + iniciarVenda(funcionario : Funcionario) : Venda
    + adicionarLinha(venda : Venda, codigoBarras : String, quantidade : int) : LinhaVenda
    + finalizarVenda(venda : Venda, metodo : MetodoPagamento, valorEntregue : double) : Fatura
    + anularVenda(venda : Venda) : void
    + calcularTroco(venda : Venda, valorEntregue : double) : double
  }

  class DevolucaoServico {
    + processarDevolucao(numeroFatura : String, codigoBarras : String, dataValidadeEmbalagem : LocalDate, quantidade : int) : Devolucao
    + validarDevolucao(fatura : Fatura, lote : Lote, quantidade : int) : boolean
  }

  class RemessaServico {
    + registarRemessa(fornecedor : Fornecedor, linhas : List<LinhaRemessa>, valorTotalGuia : double) : Remessa
    + associarPedido(remessa : Remessa) : void
    + criarPedidoRemessa(fornecedor : Fornecedor, linhas : List<LinhaPedidoRemessa>) : PedidoRemessa
  }

  class PagamentoServico {
    + listarPendentes() : List<Pagamento>
    + liquidar(pagamento : Pagamento) : void
  }

  class CaixaServico {
    + abrirSessao(fundoInicial : List<DetalheNumerario>, limiteMaximo : double) : SessaoCaixa
    + registarSangria(sessao : SessaoCaixa, valor : List<DetalheNumerario>) : Sangria
    + fecharSessao(sessao : SessaoCaixa) : void
    + verificarLimite(sessao : SessaoCaixa) : boolean
  }

  class FechoDiaServico {
    + executarFecho(configuracao : ConfiguracaoTerminal, funcionario : Manager) : FechoDia
    + reenviar(fechoDia : FechoDia) : boolean
    + reverterEmTransito() : void
  }

  class AutenticacaoServico {
    + autenticar(nomeUtilizador : String, palavraPasse : String) : Funcionario
    + encerrarSessao(funcionario : Funcionario) : void
    + verificarSessaoDuplicada(funcionario : Funcionario) : boolean
  }

  class CatalogoServico {
    + criarProduto(produto : Produto) : void
    + editarProduto(produto : Produto) : void
    + desativarProduto(id : int) : void
    + aplicarDesconto(lote : Lote, percentagem : double, manager : Manager) : Desconto
    + gerarAlertasStockMinimo() : List<Produto>
    + gerarAlertasValidade(diasLimite : int) : List<Lote>
  }

  ' Dependências para os repositórios (apenas para referência)
  VendaServico ..> VendaRepositorio
  DevolucaoServico ..> DevolucaoRepositorio
  RemessaServico ..> RemessaRepositorio
  PagamentoServico ..> PagamentoRepositorio
  CatalogoServico ..> ProdutoRepositorio
  CatalogoServico ..> LoteRepositorio
  FechoDiaServico ..> VendaRepositorio
  FechoDiaServico ..> DevolucaoRepositorio
  FechoDiaServico ..> RemessaRepositorio
  FechoDiaServico ..> PagamentoRepositorio
  FechoDiaServico ..> LogAuditoriaRepositorio
  AutenticacaoServico ..> FuncionarioRepositorio
}

@enduml