@startuml seq_processamento_devolucao
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 160
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #534AB7
skinparam sequenceParticipantBackgroundColor #EEEDFE
skinparam sequenceActorBorderColor #534AB7
skinparam sequenceActorBackgroundColor #EEEDFE
skinparam sequenceLifeLineBorderColor #534AB7
skinparam sequenceGroupBorderColor #888888
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam noteBorderColor #534AB7
skinparam noteBackgroundColor #FFFDE7
skinparam sequenceDividerBorderColor #534AB7
skinparam sequenceDividerBackgroundColor #EEF4FF

title Diagrama de Sequência — Processamento de Devolução (Software de Loja)

actor "Funcionário /\nGestor" as Actor

participant "DevolucaoController"     as Controller  #EEF4FF
participant "DevolucaoServico"        as Servico     #EEF9F4
participant "AutorizacaoServico"      as AutorizServ #EEF9F4
participant "AuditoriaServico"        as AuditServ   #EEF9F4
participant "FaturaRepositorio"       as FaturaRepo  #FFF8EE
participant "ProdutoRepositorio"      as ProdRepo    #FFF8EE
participant "LoteRepositorio"         as LoteRepo    #FFF8EE
participant "DevolucaoRepositorio"    as DevRepo     #FFF8EE
participant "LogAuditoriaRepositorio" as LogRepo     #FFF8EE
participant "Fatura"                  as Fatura      #FEFEFE
participant "Lote"                    as Lote        #FEFEFE
participant "Devolucao"               as Devolucao   #FEFEFE

== Submissão do Pedido de Devolução ==

Actor -> Controller : onProcessarDevolucao(\n  numeroFatura, codigoBarras,\n  dataValidade, quantidade)
activate Controller

Controller -> AutorizServ : exigirPerfil(utilizador, [FUNCIONARIO, GESTOR, CEO])
activate AutorizServ
alt perfil não autorizado
    AutorizServ --> Controller : throw AcessoNegadoException
    Controller --> Actor : apresentar mensagem "Acesso negado"
    deactivate AutorizServ
else autorizado
    AutorizServ --> Controller : void
    deactivate AutorizServ

    Controller -> Servico : processar(\n  numeroFatura, codigoBarras,\n  dataValidade, quantidade)
    activate Servico

    == Validação da Fatura ==

    Servico -> FaturaRepo : buscarPorNumero(numeroFatura)
    activate FaturaRepo
    FaturaRepo --> Servico : fatura : Fatura | null
    deactivate FaturaRepo

    alt fatura não encontrada
        Servico --> Controller : throw FaturaNaoEncontradaException
        Controller --> Actor : apresentar mensagem "Fatura não encontrada"

    else fatura encontrada

        Servico -> Fatura : getIdVenda()
        activate Fatura
        Fatura --> Servico : int
        deactivate Fatura

        == Validação do Produto e Lote ==

        Servico -> ProdRepo : buscarPorCodigoBarras(codigoBarras)
        activate ProdRepo
        ProdRepo --> Servico : produto : Produto | null
        deactivate ProdRepo

        alt produto não encontrado
            Servico --> Controller : throw ProdutoNaoEncontradoException
            Controller --> Actor : apresentar mensagem "Produto não encontrado"

        else produto encontrado

            Servico -> LoteRepo : buscarLotesFEFO(produto.getId())
            activate LoteRepo
            LoteRepo --> Servico : lotes : List<Lote>
            deactivate LoteRepo

            note right of Servico
                Identifica o lote da venda
                original com base na
                dataValidadeEmbalagem
                fornecida pelo cliente
            end note

            alt lote correspondente não encontrado
                Servico --> Controller : throw LoteNaoIdentificadoException
                Controller --> Actor : apresentar mensagem "Não foi possível identificar\no lote do artigo devolvido"

            else lote identificado

                == Validação das Regras de Devolução ==

                Servico -> Servico : validar(fatura, lote, quantidade)
                activate Servico

                Servico -> Lote : getQuantidade()
                activate Lote
                Lote --> Servico : int
                deactivate Lote

                alt quantidade devolvida > quantidade comprada
                    Servico --> Servico : false
                    deactivate Servico
                    Servico --> Controller : throw QuantidadeInvalidaException
                    Controller --> Actor : apresentar mensagem "Quantidade a devolver\nsuperior à comprada"

                else quantidade válida
                    Servico --> Servico : true
                    deactivate Servico

                    opt artigo já foi devolvido anteriormente (devolução parcial)
                        Servico -> DevRepo : buscarPorFatura(numeroFatura)
                        activate DevRepo
                        DevRepo --> Servico : devolucoes : List<Devolucao>
                        deactivate DevRepo

                        note right of Servico
                            Verifica se a soma das
                            quantidades já devolvidas
                            mais a actual não excede
                            a quantidade comprada
                        end note

                        alt total de devoluções excede compra
                            Servico --> Controller : throw DevolucaoExcedidaException
                            Controller --> Actor : apresentar mensagem "Limite de devolução\njá atingido para este artigo"
                        end
                    end

                    == Registo da Devolução ==

                    Servico -> Devolucao ** : new Devolucao(\n  fatura.getNumeroFatura(),\n  quantidade,\n  dataValidade,\n  utilizador.getId())
                    activate Devolucao
                    note right of Devolucao
                        estadoSincronizacao = PENDENTE
                        idLoja de ConfiguracaoTerminal
                    end note
                    deactivate Devolucao

                    Servico -> DevRepo : guardar(devolucao)
                    activate DevRepo
                    DevRepo --> Servico : void
                    deactivate DevRepo

                    == Reposição de Stock ==

                    Servico -> Lote : quantidade += quantidade devolvida
                    activate Lote
                    deactivate Lote

                    Servico -> LoteRepo : atualizar(lote)
                    activate LoteRepo
                    LoteRepo --> Servico : void
                    deactivate LoteRepo

                    == Auditoria ==

                    Servico -> AuditServ : registar(\n  utilizador, DEVOLUCAO,\n  "Devolucao", devolucao.getId())
                    activate AuditServ

                    AuditServ -> LogRepo : guardar(logAuditoria)
                    activate LogRepo
                    LogRepo --> AuditServ : void
                    deactivate LogRepo

                    AuditServ --> Servico : void
                    deactivate AuditServ

                    Servico --> Controller : devolucao : Devolucao
                    deactivate Servico

                    Controller --> Actor : apresentar confirmação de devolução\ne valor a restituir ao cliente
                end
            end
        end
    end
end

deactivate Controller

@enduml
