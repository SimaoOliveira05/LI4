<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.trasmum.loja.apresentacao.controllers.CaixaController"
      spacing="16" styleClass="view-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Gestão de Caixa" styleClass="view-title"/>

    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="status-bar">
        <Label fx:id="lblEstadoSessao" styleClass="estado-label"/>
        <Label fx:id="lblSaldo" styleClass="saldo-label"/>
    </HBox>

    <HBox spacing="8">
        <Button fx:id="btnAbrirSessao"     text="Abrir Sessão"     onAction="#onAbrirSessao"     styleClass="btn-primary"/>
        <Button fx:id="btnRegistarSangria" text="Registar Sangria" onAction="#onRegistarSangria" styleClass="btn-secondary"/>
        <Button fx:id="btnFecharSessao"    text="Fechar Sessão"    onAction="#onFecharSessao"    styleClass="btn-danger"/>
    </HBox>

    <!-- Formulário inline de numerário — oculto por defeito -->
    <VBox fx:id="formNumerario" spacing="8" managed="false" visible="false">
        <Label fx:id="lblFormTitulo" styleClass="section-title"/>
        <TableView fx:id="tblNumerarioForm" editable="true" prefHeight="340">
            <columns>
                <TableColumn fx:id="colFormDenom"    text="Denominação"  prefWidth="200"/>
                <TableColumn fx:id="colFormQtd"      text="Qtd."         prefWidth="80"/>
                <TableColumn fx:id="colFormSubtotal" text="Subtotal (€)" prefWidth="110"/>
            </columns>
        </TableView>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Label fx:id="lblFormTotal" styleClass="saldo-label"/>
            <Button text="Confirmar" onAction="#onConfirmarNumerario" styleClass="btn-primary"/>
            <Button text="Cancelar"  onAction="#onCancelarNumerario"  styleClass="btn-secondary"/>
        </HBox>
    </VBox>

    <Label fx:id="lblFundoInicial" styleClass="saldo-label"/>
</VBox>
