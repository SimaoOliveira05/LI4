@startuml DS6_Registo_Remessa_Atual
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceParticipantBorderColor #993C1D
skinparam sequenceParticipantBackgroundColor #FAECE7
skinparam sequenceActorBorderColor #993C1D
skinparam sequenceActorBackgroundColor #FAECE7
skinparam sequenceLifeLineBorderColor #F0997B
skinparam sequenceGroupBackgroundColor #FDF6F4
skinparam sequenceGroupBorderColor #F0997B
skinparam noteBorderColor #534AB7
skinparam noteBackgroundColor #EEEDFE

title DS6 — Registo de Remessa (Implementação Actual)\ncom validação Fornecedor-Produto (FornecedorProduto N:N)

actor "Gestor" as G
participant "RemessaController" as RC <<Apresentação>>
participant "IAutorizacaoServico" as AZ <<Serviço>>
participant "IRemessaServico" as RS <<Serviço>>
participant "IAuditoriaServico" as AU <<Serviço>>
participant "FornecedorProdutoRepositorio" as FPR <<Repositório>>
participant "ProdutoRepositorio" as PR <<Repositório>>
participant "LoteRepositorio" as LR <<Repositório>>
participant "RemessaRepositorio" as RR <<Repositório>>
participant "PedidoRemessaRepositorio" as PRR <<Repositório>>
participant "PagamentoRepositorio" as PAR <<Repositório>>

== Autorização ==
G -> RC : onRegistarRemessa(dados, idPedidoRemessa)
activate RC
RC -> AZ : exigirPerfil(utilizador, GESTOR, CEO)
AZ --> RC : ok

RC -> RS : registarRemessa(utilizador, fornecedor,\nlinhas, valorTotalGuia, idPedidoRemessa)
activate RS

== Validação das linhas (com Fornecedor-Produto) ==

alt linhas vazias
  RS --> RC : <<lança>> RemessaSemLinhasException
  RC --> G : alerta
else linhas válidas

  loop para cada LinhaRemessa
    RS -> PR : buscarPorId(linha.idProduto)
    PR --> RS : produto

    alt produto inválido / inactivo
      RS --> RC : <<lança>> ProdutoNaoEncontradoException
      RC --> G : alerta
    else produto válido

      ' Validação adicional do desvio: o fornecedor tem de fornecer este produto.
      RS -> FPR : fornece(idFornecedor, idProduto)
      FPR --> RS : true/false

      alt fornecedor não fornece o produto
        RS --> RC : <<lança>> ProdutoNaoFornecidoException
        RC --> G : alerta — "Fornecedor não\nfornece este produto"
      else fornece
        note over RS, LR
          Cria-se um Lote independente por
          linha (data de validade pode ser
          NULL se Produto.temValidade = false).
        end note
        RS -> LR : guardar(lote)
        LR --> RS : idLote
      end
    end
  end

  == Persistência da remessa ==
  RS -> RR : guardar(remessa)

  == Associação a pedido pendente ==
  alt idPedidoRemessa fornecido
    RS -> PRR : atualizar(pedido — CONCLUIDO)
  else procurar pedido pendente
    RS -> PRR : buscarPendentesPorFornecedor(idFornecedor)
    PRR --> RS : pedidos
    alt existe
      RS -> PRR : atualizar(pedido — CONCLUIDO)
    end
  end

  == Geração do pagamento pendente ==
  RS -> PAR : guardar(pagamento — PENDENTE)

  == Auditoria ==
  RS -> AU : registar(utilizador, ALTERACAO_CATALOGO,\n"Remessa", remessa.id)

  RS --> RC : remessa
  deactivate RS
  RC --> G : confirmação
  deactivate RC
end

@enduml
