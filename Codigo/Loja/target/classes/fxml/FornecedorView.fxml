<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.trasmum.loja.apresentacao.controllers.FornecedorController"
            styleClass="view-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <top>
        <VBox spacing="8">
            <Label text="Fornecedores" styleClass="view-title"/>
            <HBox spacing="8">
                <Button text="Novo"   onAction="#onCriarFornecedor" styleClass="btn-primary"/>
                <Button text="Editar" onAction="#onEditarFornecedor" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="12">
            <!-- Esquerda: lista de fornecedores -->
            <VBox HBox.hgrow="ALWAYS" spacing="8" minWidth="0">
                <Label text="Lista" styleClass="section-title"/>
                <TableView fx:id="tblFornecedores" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFId"     text="#"        prefWidth="48"/>
                        <TableColumn fx:id="colFNome"   text="Nome"     prefWidth="200"/>
                        <TableColumn fx:id="colFNif"    text="NIF"      prefWidth="110"/>
                        <TableColumn fx:id="colFEmail"  text="Email"    prefWidth="180"/>
                        <TableColumn fx:id="colFTel"    text="Telefone" prefWidth="110"/>
                    </columns>
                    <placeholder><Label text="Sem fornecedores"/></placeholder>
                </TableView>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <!-- Direita: catálogo do fornecedor seleccionado -->
            <VBox fx:id="painelCatalogo" prefWidth="440" minWidth="360" spacing="8"
                  visible="false" managed="false">
                <Label fx:id="lblCatalogoTitulo" text="Catálogo" styleClass="section-title"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cmbProdutoNovo" HBox.hgrow="ALWAYS" prefWidth="220"
                              promptText="Produto a associar…"/>
                    <TextField fx:id="txtPreco" prefWidth="90" promptText="Preço €"/>
                    <Button text="Associar" onAction="#onAssociarProduto" styleClass="btn-primary"/>
                </HBox>
                <TableView fx:id="tblCatalogo" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCatProduto" text="Produto"   prefWidth="200"/>
                        <TableColumn fx:id="colCatPreco"   text="Preço (€)" prefWidth="100"/>
                        <TableColumn fx:id="colCatAcoes"   text=""          prefWidth="120"/>
                    </columns>
                    <placeholder><Label text="Sem produtos associados"/></placeholder>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
