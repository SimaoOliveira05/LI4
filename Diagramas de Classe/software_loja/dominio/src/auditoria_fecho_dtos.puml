@startuml Software_de_Loja_Parte4d_Dominio_Auditoria_Fecho_DTOs
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #EEEDFE
skinparam classBorderColor #534AB7
skinparam classBackgroundColor #FAFAFA
skinparam arrowColor #534AB7
skinparam stereotypeCBackgroundColor #E1F5EE
skinparam stereotypeABackgroundColor #FAC775
skinparam stereotypeIBackgroundColor #D1ECF1
skinparam packageBackgroundColor #F8F8F8
skinparam packageBorderColor #B4B2A9
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 50

title Software de Loja — Domínio (Auditoria, Fecho e DTOs)

package "Auditoria e Fecho" #FEFEFE {

  enum EstadoSincronizacao {
    PENDENTE
    EM_TRANSITO
    CONFIRMADO
  }

  class FechoDia {
    - id : int
    - dataFecho : LocalDate
    - estadoEnvio : EstadoSincronizacao
    - idLoja : String
    - idUtilizador : int
    + getDataFecho() : LocalDate
    + getEstadoEnvio() : EstadoSincronizacao
    + getIdLoja() : String
  }
  note bottom of FechoDia
    idLoja obtido de ConfiguracaoTerminal
    pelo FechoDiaServico (RF16, ADR-02).
    Compilação e envio responsabilidade
    do FechoDiaServico, não desta entidade.
  end note

  enum TipoAcao {
    VENDA
    DEVOLUCAO
    ALTERACAO_PRECO
    APLICACAO_DESCONTO
    GESTAO_UTILIZADOR
    ALTERACAO_CATALOGO
  }

  class LogAuditoria {
    - acao : TipoAcao
    - dataHora : LocalDateTime
    - idUtilizador : int
    - entidade : String
    - idEntidade : int
    + getAcao() : TipoAcao
    + getIdUtilizador() : int
  }
}

package "DTOs (Data Transfer Objects)" #FEFEFE {

  class ProdutoDTO {
    + codigoBarras : String
    + nome : String
    + categoria : String
    + precoBase : double
    + stockMinimo : int
  }

  class LinhaRemessaDTO {
    + idProduto : int
    + quantidade : int
    + dataValidade : LocalDate
  }

  class RemessaDTO {
    + idFornecedor : int
    + valorTotalGuia : double
    + linhas : List~LinhaRemessaDTO~
  }

  class LinhaPedidoDTO {
    + idProduto : int
    + quantidadePretendida : int
  }

  class PedidoRemessaDTO {
    + idFornecedor : int
    + linhas : List~LinhaPedidoDTO~
  }

  class UtilizadorDTO {
    + nomeUtilizador : String
    + palavraPasse : String
    + perfil : PerfilUtilizador
  }
}

' Relações
FechoDia --> EstadoSincronizacao
LogAuditoria --> TipoAcao

' Relação com Utilizador
LogAuditoria --> Utilizador : idUtilizador

@enduml